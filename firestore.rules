rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ===============================================================
    // GLOBAL SAFETY NET
    // ===============================================================
    match /{document=**} {
      allow read, write: if false;
    }

    // ===============================================================
    // RBAC & MULTI-TENANCY HELPERS
    // ===============================================================
    
    function isAuthenticated() {
      return request.auth != null;
    }

    // Primary lookup: trainer doc by UID (for trainers created via Firebase Auth UID as doc ID)
    function getTrainerByUID() {
      return exists(/databases/$(database)/documents/trainers/$(request.auth.uid))
        ? get(/databases/$(database)/documents/trainers/$(request.auth.uid)).data
        : null;
    }

    // Get trainer data — UID-keyed doc is the primary source
    function getTrainerData() {
      return get(/databases/$(database)/documents/trainers/$(request.auth.uid)).data;
    }

    // Check if a trainer document exists keyed by the Firebase UID
    function trainerDocExistsByUID() {
      return exists(/databases/$(database)/documents/trainers/$(request.auth.uid));
    }

    function getRole() {
      // Check JWT token claim first (fastest, no DB read)
      return request.auth != null && 'role' in request.auth.token && request.auth.token.role != null
        ? request.auth.token.role
        : (trainerDocExistsByUID()
            ? (('role' in getTrainerData() && getTrainerData().role != null)
                ? getTrainerData().role
                : 'LifeTransformer')  // Default: any authenticated trainer can train
            : 'none');
    }

    // Any authenticated user with a trainer profile anywhere in the system
    function hasAnyTrainerProfile() {
      return isAuthenticated() && trainerDocExistsByUID();
    }

    // Cost round (Sep 2026): both go through getRole(), which reads the token's
    // role claim and only falls back to trainers/{uid} when there is none. The
    // old bodies checked the claim, then ALWAYS did an exists()/get() for any
    // non-matching claim -- so a LifeTransformer's every isSuperAdmin() cost a
    // read even with a claim. The Cloud Function syncTrainerClaims keeps the
    // claim equal to the document; the answers here are unchanged either way.
    function isAdmin() {
      return isAuthenticated() && getRole() == 'Admin';
    }

    function isFounder() {
      return isAuthenticated() && (getRole() == 'Founder' || getRole() == 'Overseer');
    }

    // 1. SUPER ADMIN: Absolute master access to everything
    function isSuperAdmin() {
      return isAdmin() || isFounder();
    }

    // 2. FRANCHISE OWNER: Management authority of regional studio systems
    function isFranchiseOwnerOnly() {
      return isAuthenticated() && (
        getRole() == 'FranchiseOwner' || 
        getRole() == 'Owner'
      );
    }

    // 3. STUDIO OWNER & HEAD TRAINER: Read/write strictly bounded by location parameter
    function isStudioOwnerOrHeadTrainerOnly(studioId) {
      return isAuthenticated() && (
        // Demo Mode: everyone leads there. See the demo helpers above.
        hasRunOfDemo(studioId) ||
        // Secure Custom Token Claim check
        ('studioId' in request.auth.token && request.auth.token.studioId != null && request.auth.token.studioId == studioId) ||
        // Database Backed verification fallback
        (
          trainerDocExistsByUID() &&
          (getRole() == 'StudioOwner' || getRole() == 'HeadTrainer' || getRole() == 'StudioLeader') &&
          (
            getTrainerData().primaryHomeStudioId == studioId || 
            ('ownedStudioIds' in getTrainerData() && getTrainerData().ownedStudioIds != null && getTrainerData().ownedStudioIds.hasAny([studioId]))
          )
        ) ||
        // THE GRANT (My Studio round, Sep 2026): a trainer this studio's
        // leadership let help run it -- Trainer.managedStudioIds names the
        // studio. Whatever their role. Set only by that studio's leaders and
        // administrators (it is an access field; see writesAccessFields).
        (
          trainerDocExistsByUID() &&
          getTrainerData().get('managedStudioIds', []).hasAny([studioId])
        )
      );
    }

    function isStudioOwnerOrHeadTrainer(studioId) {
      return isStudioOwnerOrHeadTrainerOnly(studioId);
    }

    function isFranchiseOwner() {
      return isFranchiseOwnerOnly();
    }

    // 4. TRAINER: Any authenticated trainer at a studio — checks primary home, accessible, and guest studios
    function isTrainerOfStudioOnly(studioId) {
      return isAuthenticated() && trainerDocExistsByUID() && (
        // Demo Mode: everyone works there. See the demo helpers above.
        isDemoStudioId(studioId) ||
        (
          getTrainerData().primaryHomeStudioId == studioId ||
          ('accessibleStudioIds' in getTrainerData() && getTrainerData().accessibleStudioIds != null && getTrainerData().accessibleStudioIds.hasAny([studioId])) ||
          ('activeGuestStudioIds' in getTrainerData() && getTrainerData().activeGuestStudioIds != null && getTrainerData().activeGuestStudioIds.hasAny([studioId]))
        )
      );
    }

    // Extended: LifeTransformer and Trainer roles can train at their studio
    function isTrainerOfStudio(studioId) {
      return isStudioOwnerOrHeadTrainerOnly(studioId) || isTrainerOfStudioOnly(studioId);
    }

    // 5. ANY AUTHENTICATED TRAINER: For session writes, any trainer with a valid profile
    // can write sessions as long as they are authenticated — the hostedAtStudioId is set by the app
    function isAnyAuthenticatedTrainer() {
      return isAuthenticated() && trainerDocExistsByUID();
    }

    // ===============================================================
    // DEMO MODE (Sep 20 2026)
    // ===============================================================
    //
    // `demo-studio` is a real studio document full of people who do not
    // exist. Every signed-in trainer has the run of it, at every level, so a
    // trainer can rehearse the half of the app their own role keeps shut
    // without a single real record in reach. The app mirrors these two
    // answers in src/features/demo-mode/access.ts.
    //
    // The boundary is NOT a wall around this data -- it is that the studio id
    // is a literal here, and that the app never shows a demo record and a
    // real one in the same list (features/demo-mode/is-demo.ts). Deriving
    // access from the id rather than from a field on each trainer is what
    // makes it impossible to grant by mistake and impossible to lose.
    //
    // A literal, not a lookup: naming the id costs nothing, where checking a
    // flag on the studio document would spend a read on every rule that asks.

    function isDemoStudioId(studioId) {
      return studioId == 'demo-studio';
    }

    /** Everybody signed in, inside the demo studio. */
    function hasRunOfDemo(studioId) {
      return isDemoStudioId(studioId) && isAnyAuthenticatedTrainer();
    }

    /*
     * A trainer document the seeder lays down for the demo studio.
     *
     * Pinned hard: the id, the flag, the one studio it belongs to, no grant,
     * nothing owned, and a role that cannot be an elevated one. A document
     * that satisfies all of this is inert outside Demo Mode -- it names no
     * real studio, and it is not the caller's own uid document, so it can
     * never answer getRole() for anybody.
     */
    function isDemoTrainerPayload(trainerId, data) {
      return trainerId.matches('demo-trainer-.*') &&
             data.get('isDemo', false) == true &&
             data.get('primaryHomeStudioId', '') == 'demo-studio' &&
             data.get('accessibleStudioIds', []).hasOnly(['demo-studio']) &&
             data.get('managedStudioIds', []).size() == 0 &&
             data.get('ownedStudioIds', []).size() == 0 &&
             (data.get('role', '') == 'StudioLeader' ||
              data.get('role', '') == 'LifeTransformer');
    }

    // 5. HELPER: Resolve studio or homeStudioId field safely from a data map
    function getStudioIdFromData(data) {
      return data.get('homeStudioId', data.get('studioId', null));
    }

    function isTrainerOfClientData(clientId, clientData, trainerPrimary, trainerAccessible, trainerGuest) {
      return (getStudioIdFromData(clientData) != null && isTrainerOfStudio(getStudioIdFromData(clientData))) ||
             (clientData.get('approvedCrossTrainStudioIds', []).hasAny([trainerPrimary])) ||
             (clientData.get('approvedCrossTrainStudioIds', []).hasAny(trainerAccessible)) ||
             (clientData.get('approvedCrossTrainStudioIds', []).hasAny(trainerGuest));
    }

    function isTrainerOfClient(clientId) {
      return exists(/databases/$(database)/documents/clients/$(clientId)) && 
             isTrainerOfClientData(
               clientId,
               get(/databases/$(database)/documents/clients/$(clientId)).data,
               getTrainerData().primaryHomeStudioId,
               getTrainerData().get('accessibleStudioIds', []),
               getTrainerData().get('activeGuestStudioIds', [])
             );
    }

    // Can this trainer see the session at /sessions/{id}? Used by the logs
    // subcollection, which is addressable without the parent.
    function isTrainerOfSessionId(sessionId) {
      return exists(/databases/$(database)/documents/sessions/$(sessionId))
        && isTrainerOfSessionData(
             get(/databases/$(database)/documents/sessions/$(sessionId)).data);
    }

    function isTrainerOfSessionData(sessionData) {
      return sessionData.get('trainerId', '') == request.auth.uid
          || isTrainerOfStudio(sessionData.get('hostedAtStudioId', ''))
          || namedClientIsReadable(sessionData.get('clientId', ''));
    }

    // isTrainerOfClient builds /documents/clients/$(id). An empty id makes
    // that path malformed, so the emptiness check has to come first and the
    // short-circuit has to be relied on. Sessions written before
    // `hostedAtStudioId` was enforced also predate a reliable clientId.
    function namedClientIsReadable(clientId) {
      return clientId != null && clientId != '' && isTrainerOfClient(clientId);
    }

    /* ====================================================================
       EXPRESSION-BUDGET HELPERS  (Sep 9 2026)

       Firestore caps a single rule evaluation at 1000 EXPRESSIONS. That is a
       different budget from the 10-document-read limit, and it is the one the
       sessions read rule was blowing: `npm run test:rules` failed with
       "maximum of 1000 expressions to evaluate has been reached" on the
       cross-studio branch -- the exact case the tenancy work exists to serve.

       WHY THE OLD CHAIN WAS SO EXPENSIVE
       Arguments are evaluated EAGERLY and nothing is memoised, so each helper
       re-derives what the last one just computed:
         getRole()                      -> up to 3 getTrainerData() call sites
         isSuperAdmin()                 -> up to 3 getRole()  = ~9 more
         isFranchiseOwnerOnly()         -> 2 getRole()        = ~6 more
         isTrainerOfStudio(studioId)    -> ~15 (two helpers, each re-reading)
         namedClientIsReadable(...)     -> all of the above AGAIN, per client
       The document reads were cached; the expression count was not.

       THE FIX: resolve the caller ONCE at the rule, then pass the role string
       and the trainer map down into predicates that only do map lookups. No
       function below reads a document except sessionClientIsReadable, which
       reads exactly one client.

       These are ADDITIVE. The originals above are untouched and every other
       rule still uses them, so this round can only affect the sessions read
       it was written for.
       ==================================================================== */

    function roleIsSuper(r) {
      return r == 'Admin' || r == 'Founder' || r == 'Overseer';
    }

    function roleIsFranchise(r) {
      return r == 'FranchiseOwner' || r == 'Owner';
    }

    function roleIsStudioLeader(r) {
      return r == 'StudioOwner' || r == 'HeadTrainer' || r == 'StudioLeader';
    }

    /** The caller's trainer document, or null. One read, one call site. */
    function callerTrainer() {
      return trainerDocExistsByUID() ? getTrainerData() : null;
    }

    /** Works here, as a trainer. Pure map lookups against an already-read doc. */
    function trainerWorksAt(t, studioId) {
      return t != null && studioId != null && studioId != '' && (
        isDemoStudioId(studioId) ||
        t.get('primaryHomeStudioId', '') == studioId ||
        t.get('accessibleStudioIds', []).hasAny([studioId]) ||
        t.get('activeGuestStudioIds', []).hasAny([studioId])
      );
    }

    /** Runs this location. Mirrors isStudioOwnerOrHeadTrainerOnly's DB branch. */
    function trainerLeads(r, t, studioId) {
      return studioId != null && studioId != '' && (
        (t != null && isDemoStudioId(studioId)) ||
        // The custom-claim fast path, carried over verbatim from
        // isStudioOwnerOrHeadTrainerOnly. It never fires: the only claim
        // ever set is `role` (syncTrainerClaims, cost round Sep 2026), and
        // `studioId` is deliberately never set -- as written it would grant
        // studio-leader access with no role check at all.
        ('studioId' in request.auth.token &&
          request.auth.token.studioId != null &&
          request.auth.token.studioId == studioId) ||
        (t != null && roleIsStudioLeader(r) && (
          t.get('primaryHomeStudioId', '') == studioId ||
          t.get('ownedStudioIds', []).hasAny([studioId])
        )) ||
        // The grant (My Studio round, Sep 2026) -- see isStudioOwnerOrHeadTrainerOnly.
        (t != null && t.get('managedStudioIds', []).hasAny([studioId]))
      );
    }

    /** Runs SOME studio: a studio-leader role, or the grant anywhere. */
    function leadsAnyStudio(r, t) {
      return roleIsStudioLeader(r) || (t != null && t.get('managedStudioIds', []).size() > 0);
    }

    /* WHAT A CALLER MAY HAND OUT (My Studio round, Sep 2026). AJ, Sep 18:
       a studio's leaders hand out trainer, head trainer and studio leader --
       "never owner and admin". A franchise owner may hand out the owner
       tier too. Administrators, anything. A null role is "not set yet". */
    function studioTierRole(role) {
      return role == null || role == 'LifeTransformer' || role == 'Trainer'
          || role == 'HeadTrainer' || role == 'StudioLeader';
    }

    function mayHandOut(r, role) {
      return roleIsSuper(r)
          || (roleIsFranchise(r) && !roleIsSuper(role))
          || studioTierRole(role);
    }

    /** homeStudioId, falling back to studioId. Mirrors getStudioIdFromData. */
    function studioIdOf(d) {
      return d.get('homeStudioId', d.get('studioId', ''));
    }

    /*
     * Can this caller read this ALREADY-READ client document?
     *
     * The three cross-train checks come FIRST and are pure array work. The old
     * order put the studio check first, so the cross-train case -- a client
     * visiting from another location, which is precisely the case that failed
     * -- paid for the whole expensive branch before reaching the cheap one
     * that was going to say yes.
     */
    function clientIsReadableBy(c, r, t) {
      return t != null && (
        c.get('approvedCrossTrainStudioIds', []).hasAny([t.get('primaryHomeStudioId', '')]) ||
        c.get('approvedCrossTrainStudioIds', []).hasAny(t.get('accessibleStudioIds', [])) ||
        c.get('approvedCrossTrainStudioIds', []).hasAny(t.get('activeGuestStudioIds', [])) ||
        trainerWorksAt(t, studioIdOf(c)) ||
        trainerLeads(r, t, studioIdOf(c))
      );
    }

    /*
     * A cross-train visitor's session moving the client's totals (Sep 24
     * 2026). The caller works at a studio the client is approved to train at
     * (the three list checks of clientIsReadableBy, which let them READ the
     * client), and the write touches only what a session moves:
     *   Finish      completedSessions, sessionCount, lastSessionDate,
     *               updatedAt, lifetimeReps, lifetimeWeight,
     *               currentMachineMetrics, consultationCompleted,
     *               trainerTally, trainerTallyUpdatedAt, topTrainerId,
     *               topTrainerName, topTrainerSessions, machineStats
     *   Start       isRoutineBActive, firstSessionDate
     *   History     the same counters, given back on a delete or an edit
     *   Pulse       subjectiveSnapshot (finalizeCheckIn: the summary of the
     *               Pulse the visitor may already write to progressReports)
     * Pure map work on the already-read trainer: no document read.
     */
    function crossTrainSessionTotals(c, t) {
      return t != null
        && (c.get('approvedCrossTrainStudioIds', []).hasAny([t.get('primaryHomeStudioId', '')])
            || c.get('approvedCrossTrainStudioIds', []).hasAny(t.get('accessibleStudioIds', []))
            || c.get('approvedCrossTrainStudioIds', []).hasAny(t.get('activeGuestStudioIds', [])))
        && request.resource.data.diff(c).affectedKeys().hasOnly([
             'completedSessions', 'sessionCount', 'lastSessionDate', 'updatedAt',
             'lifetimeReps', 'lifetimeWeight', 'currentMachineMetrics', 'consultationCompleted',
             'trainerTally', 'trainerTallyUpdatedAt', 'topTrainerId', 'topTrainerName',
             'topTrainerSessions', 'machineStats', 'isRoutineBActive', 'firstSessionDate',
             'subjectiveSnapshot']);
    }

    /*
     * The one document read on this path. Guarded on a non-empty id first:
     * isTrainerOfClient('') builds the malformed path /documents/clients/ and
     * relies on short-circuit to never get there.
     */
    function sessionClientIsReadable(cid, r, t) {
      return cid != null && cid != '' &&
        exists(/databases/$(database)/documents/clients/$(cid)) &&
        clientIsReadableBy(
          get(/databases/$(database)/documents/clients/$(cid)).data, r, t);
    }

    /*
     * SESSIONS ARE SCOPED BY CLIENT, NOT BY STUDIO -- unchanged policy, see the
     * comment above match /sessions. A session is never more visible than the
     * person it is about, and a legacy session with no studio and no client
     * stays readable by its own trainer rather than by nobody.
     */
    function sessionIsReadable(s, r, t) {
      return roleIsSuper(r) || roleIsFranchise(r) || (t != null && (
        s.get('trainerId', '') == request.auth.uid ||
        trainerWorksAt(t, s.get('hostedAtStudioId', '')) ||
        trainerLeads(r, t, s.get('hostedAtStudioId', '')) ||
        sessionClientIsReadable(s.get('clientId', ''), r, t)
      ));
    }

    /* ====================================================================
       RENEWALS (Renewals round, Sep 2026)

       Same shape as the helpers above: the caller is resolved ONCE at the
       rule and the role string and trainer map are passed in, so these cost
       map lookups, not document reads.

         readable   - works at or runs this studio, or reaches every studio
         manageable - runs this studio (a studio leader of it), or reaches
                      every studio. Per-trainer renewal rates, the pipeline's
                      stage / lead / outcome and the studio's renewal
                      settings are for leaders only (AJ, Sep 10 2026).
       ==================================================================== */

    function renewalsReadable(studioId, r, t) {
      return roleIsSuper(r) || roleIsFranchise(r) ||
             trainerWorksAt(t, studioId) || trainerLeads(r, t, studioId);
    }

    function renewalsManageable(studioId, r, t) {
      return roleIsSuper(r) || roleIsFranchise(r) || trainerLeads(r, t, studioId);
    }

    /** Absent, or a number inside [lo, hi]. */
    function numberWithin(d, key, lo, hi) {
      return !(key in d) || (d[key] is number && d[key] >= lo && d[key] <= hi);
    }

    /**
     * studios/{s}/config/renewals. The app cleans every value again when it
     * reads them (features/renewals/settings.ts), so this only has to keep
     * out shapes that could never be right.
     */
    function renewalSettingsValid(d) {
      return d.keys().hasOnly([
               'conversationAtSessionsLeft', 'chargeWarnDays', 'chargeWarnMinBanked',
               'horizonMonths', 'breakDays', 'lostAfterDays', 'payAsYouGoCountsAs',
               'pauseDuringAwayEvents', 'packages', 'extraSessionNames',
               'updatedAt', 'updatedBy'])
          && numberWithin(d, 'conversationAtSessionsLeft', 0, 60)
          && numberWithin(d, 'chargeWarnDays', 0, 180)
          && numberWithin(d, 'chargeWarnMinBanked', 1, 100)
          && numberWithin(d, 'horizonMonths', 1, 12)
          && numberWithin(d, 'breakDays', 7, 90)
          && numberWithin(d, 'lostAfterDays', 0, 365)
          && (!('payAsYouGoCountsAs' in d) || d.payAsYouGoCountsAs in ['retained', 'lost'])
          && (!('pauseDuringAwayEvents' in d) || d.pauseDuringAwayEvents is bool)
          && (!('packages' in d) ||
              (d.packages is list && d.packages.size() >= 1 && d.packages.size() <= 12))
          && (!('extraSessionNames' in d) ||
              (d.extraSessionNames is list && d.extraSessionNames.size() <= 40))
          && d.get('updatedBy', '') == request.auth.uid;
    }

    /** What a trainer's conversation log may write on a renewal cycle. */
    function renewalTrainerKeys() {
      return ['clientId', 'clientName', 'cycleKey', 'packageKey', 'chargeDate',
              'latestLeaning', 'latestConcerns', 'latestInterestedIn',
              'needsLeader', 'lastTouchAt', 'lastTouchBy', 'lastTouchByName',
              'touchCount'];
    }

    /**
     * Leaders may also set the stage, the lead and the outcome. EVERY field
     * the nightly job writes must be listed here too: a leader's write is
     * checked against the whole document, so one unlisted job field would
     * lock leaders out of that cycle for good.
     */
    function renewalCycleKeys() {
      return renewalTrainerKeys().concat([
              'stage', 'leadTrainerId', 'outcome', 'outcomeAt', 'outcomeBy',
              'nextCycleKey', 'nextPackageKey', 'closedOn', 'primaryTrainerId',
              'updatedAt', 'updatedBy']);
    }

    function renewalLeanings() {
      return ['renewing', 'leaning-yes', 'unsure', 'leaning-no', 'not-renewing'];
    }

    /**
     * A trainer logging a conversation: only the trainer fields change, and
     * the conversation is signed by the person writing it.
     */
    function renewalTrainerWrite() {
      return request.resource.data.get('lastTouchBy', '') == request.auth.uid
          && request.resource.data.get('latestLeaning', 'unsure') in renewalLeanings()
          // Only as a side effect of logging a conversation, now: stamped by
          // the server, and counted one at a time.
          && request.resource.data.get('lastTouchAt', null) == request.time
          && request.resource.data.get('touchCount', 0) ==
               (resource == null ? 0 : resource.data.get('touchCount', 0)) + 1
          && (resource == null
                ? request.resource.data.keys().hasOnly(renewalTrainerKeys())
                : request.resource.data.diff(resource.data).affectedKeys()
                    .hasOnly(renewalTrainerKeys()));
    }

    function renewalLeaderWrite() {
      return request.resource.data.keys().hasOnly(renewalCycleKeys())
          && request.resource.data.get('stage', 'not-started') in ['not-started', 'talking', 'decided']
          && (request.resource.data.get('outcome', null) == null ||
              request.resource.data.outcome in
                ['renewed', 'upgraded', 'downgraded', 'pay-as-you-go', 'lost'])
          && (request.resource.data.get('closedOn', null) == null ||
              (request.resource.data.closedOn is string &&
               request.resource.data.closedOn.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')));
    }

    /** One logged conversation. Signed by its author; never edited. */
    function renewalTouchValid(d) {
      return d.keys().hasOnly(['clientId', 'authorId', 'authorName', 'at', 'leaning',
                               'concerns', 'interestedIn', 'note', 'needsLeader'])
          && d.authorId == request.auth.uid
          && d.at == request.time
          && d.leaning in renewalLeanings()
          && d.concerns is list && d.concerns.size() <= 8
          && d.note is string && d.note.size() <= 500
          && d.needsLeader is bool;
    }

    /* ====================================================================
       INBODY SCANS (Renewals round, Sep 2026)

       clients/{clientId}/inbodyScans/{scanId}: the numbers from one InBody
       printout. Body composition is health data, so a scan reads like a
       session -- only people who can open the client -- never like the open
       progressReports collection.

       Writes mirror the clients/{id} UPDATE rule on purpose: every scan
       write is a batch that also rewrites clients/{id}.inbodySummary, and the
       two halves must never disagree about who may make them.

       The ranges here are wider than the app's (features/inbody/scans.ts):
       the app catches typos; these only keep out shapes that are never right.
       ==================================================================== */

    function inbodyNumber(d, key, lo, hi) {
      return d[key] is number && d[key] >= lo && d[key] <= hi;
    }

    /** Absent, null, or a number inside [lo, hi]. */
    function inbodyOptional(d, key, lo, hi) {
      return !(key in d) || d[key] == null || inbodyNumber(d, key, lo, hi);
    }

    function inbodyScanValid(d) {
      return d.keys().hasOnly(['testedAt', 'device', 'source', 'studioId', 'enteredBy',
                               'enteredByName', 'createdAt', 'updatedBy', 'updatedAt',
                               'weightLb', 'skeletalMuscleMassLb', 'bodyFatMassLb',
                               'percentBodyFat', 'bmi', 'totalBodyWaterLb', 'dryLeanMassLb',
                               'fatFreeMassLb', 'basalMetabolicRateKcal', 'smi', 'phaseAngle',
                               'segmentalLean'])
          && d.testedAt is string && d.testedAt.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
          && d.device is string && d.device.size() <= 40
          && inbodyNumber(d, 'weightLb', 20, 800)
          && inbodyNumber(d, 'skeletalMuscleMassLb', 1, 400)
          && inbodyNumber(d, 'bodyFatMassLb', 0, 700)
          && inbodyNumber(d, 'percentBodyFat', 0, 90)
          && d.skeletalMuscleMassLb + d.bodyFatMassLb < d.weightLb
          && inbodyOptional(d, 'bmi', 5, 100)
          && inbodyOptional(d, 'totalBodyWaterLb', 0, 500)
          && inbodyOptional(d, 'dryLeanMassLb', 0, 300)
          && inbodyOptional(d, 'fatFreeMassLb', 0, 800)
          && inbodyOptional(d, 'basalMetabolicRateKcal', 0, 10000)
          && inbodyOptional(d, 'smi', 0, 40)
          && inbodyOptional(d, 'phaseAngle', 0, 30)
          && (!('segmentalLean' in d) || d.segmentalLean == null || d.segmentalLean is map);
    }

    /** The scan's client's studio. One read, cached for the whole request. */
    function inbodyClientStudio(clientId) {
      return studioIdOf(get(/databases/$(database)/documents/clients/$(clientId)).data);
    }

    /** Mirrors match /clients/{clientId}'s update rule.
     *  Takes the pre-computed role string and trainer map so it stays within
     *  the 1000-expression budget. Callers must pass getRole() and callerTrainer().
     */
    function inbodyWritable(clientId, r, t) {
      return t != null
          && exists(/databases/$(database)/documents/clients/$(clientId))
          && (roleIsSuper(r) || roleIsFranchise(r)
              || trainerWorksAt(t, inbodyClientStudio(clientId))
              || trainerLeads(r, t, inbodyClientStudio(clientId)));
    }

    function isTrainerOfStudioOrClient(studioId, clientId) {
      return isSuperAdmin() || isFranchiseOwnerOnly() || (
        isAuthenticated() && (
          (studioId != null && isTrainerOfStudio(studioId)) ||
          (clientId != null && isTrainerOfClient(clientId))
        )
      );
    }

    function hasRequiredFields(fields) {
      return request.resource.data.keys().hasAll(fields);
    }

    // ===============================================================
    // VALIDATORS & PROPERTY MATCHERS
    // ===============================================================

    /**
     * A trainer document someone is creating FOR THEMSELVES may not hand
     * itself a privileged role.
     *
     * The bootstrap clause on `allow create` exists so a signed-in person can
     * own trainers/{their uid} — the claim at first sign-in depends on it, and
     * so does the very first account on a new project. But isValidTrainer
     * places no constraint on `role`, so until now any signed-in Google
     * account could create trainers/{its own uid} with role "Admin" and become
     * a system administrator. The UPDATE rule has always refused exactly that
     * escalation; create simply never did, and phase 8 makes the gap matter
     * more, because approval is now the only intended way to get an account.
     *
     * The ceiling is deliberately the SAME three roles update refuses, no
     * more. Owner and StudioOwner stay allowed because placeholder profiles
     * created by the old Franchise "Add New" path carry them, and those
     * profiles still have to be claimable by the people they belong to.
     *
     * The owner's own bootstrap is exempted by email, mirroring the hard-coded
     * bootstrap in src/hooks/useAuthInitialization.ts. It is not new surface —
     * that address already boots itself an admin profile in app code.
     *
     * Recovery if this ever blocks someone who should be an admin: an existing
     * super admin sets the role, which the update rule permits.
     */
    function selfCreatedRoleIsAllowed() {
      return !('role' in request.resource.data)
          || request.resource.data.role == null
          // The owner's own bootstrap, mirroring useAuthInitialization.ts.
          || (request.resource.data.role == 'Admin'
              && request.auth.token.email == 'jurgensaj@gmail.com')
          || (request.resource.data.role != 'Admin'
              && request.resource.data.role != 'Founder'
              && request.resource.data.role != 'Overseer');
    }

    function isValidTrainer(data) {
      // Trainer PINs were removed in Sep 2026 and `pinHash` is no longer a
      // field anywhere in the app. The refusal stays as a belt: a client that
      // somehow still writes one is refused rather than quietly storing a
      // credential nothing will ever check.
      return !('pinHash' in data) &&
             hasRequiredFields(['fullName', 'initials', 'primaryHomeStudioId']) &&
             data.fullName is string && data.fullName.size() > 0 && data.fullName.size() < 100 &&
             data.initials is string && data.initials.size() >= 2 && data.initials.size() <= 4 &&
             data.primaryHomeStudioId is string && data.primaryHomeStudioId.size() > 0 && data.primaryHomeStudioId.size() < 100 &&
             (!('role' in data) || data.role == null || data.role is string) &&
             (!('accessibleStudioIds' in data) || data.accessibleStudioIds == null || data.accessibleStudioIds is list) &&
             (!('activeGuestStudioIds' in data) || data.activeGuestStudioIds == null || data.activeGuestStudioIds is list) &&
             (!('createdAt' in data) || data.createdAt == null || data.createdAt is timestamp || data.createdAt is string);
    }

    function isValidClient(data) {
      return hasRequiredFields(['firstName', 'lastName', 'isActive', 'remainingSessions']) &&
             data.firstName is string && data.firstName.size() > 0 && data.firstName.size() < 50 &&
             data.lastName is string && data.lastName.size() > 0 && data.lastName.size() < 50 &&
             data.isActive is bool &&
             data.remainingSessions is number && data.remainingSessions >= 0;
    }

    function isValidMachine(data) {
      return hasRequiredFields(['name', 'order']) &&
             data.name is string && data.name.size() > 0 &&
             data.order is number;
    }

    function isValidSession(data) {
      return (!data.keys().hasAll(['sessionNumber']) || data.sessionNumber is number) &&
             (!data.keys().hasAll(['date']) || data.date is string) &&
             (!data.keys().hasAll(['trainerInitials']) || data.trainerInitials is string);
    }

    // Since updates can be partial list updates, we enforce type-safety for incoming fields
    function isValidLog(data) {
      return hasRequiredFields(['sessionId', 'machineId']) &&
             data.sessionId is string &&
             data.machineId is string;
    }

    function isValidSchedule(data) {
      return hasRequiredFields(['clientName', 'trainerName', 'startTime', 'endTime', 'status', 'serviceName', 'source']);
    }

    function isValidNetwork(data) {
      return hasRequiredFields(['name', 'ownerId', 'studioIds']) &&
             data.name is string && data.name.size() > 0 && data.name.size() < 100 &&
             data.ownerId is string &&
             data.studioIds is list;
    }

    function isValidHubAnnouncement(data) {
      return hasRequiredFields(['title', 'shortContent', 'longContent', 'authorId', 'authorName', 'studioId', 'isActive', 'priority']);
    }

    /* A link from an announcement to a page in Learning (Learning + Planner
       round). Mirrors parseLearningRef in src/features/learning/ref.ts. */
    function learningLinkValid(l) {
      return l is map
          && l.keys().hasOnly(['kind', 'id', 'moduleId', 'studioId', 'title'])
          && l.kind in ['machine', 'academy-card', 'academy-script', 'academy-overview',
                        'academy-module', 'academy-topic', 'academy-cueing',
                        'academy-glossary', 'studio-page']
          && (!('id' in l) || (l.id is string && l.id.size() > 0 && l.id.size() <= 200))
          && (!('title' in l) || (l.title is string && l.title.size() <= 160));
    }

    /* Who the app offers the announcement composer to: the Operations
       Announcements tab (administrators, founders, franchise owners) and the
       Franchise hub (those, and studio owners). */
    function canPostAnnouncements() {
      return isSuperAdmin() || isFranchiseOwnerOnly() || getRole() == 'StudioOwner';
    }

    /* Everyone at every studio. Only the Operations tab offers it, so only
       its people may send one; the Franchise hub never offers it. */
    function reachesEveryStudio(d) {
      return d.get('targetScope', '') == 'universal' || d.get('studioId', '') == 'all';
    }

    /* catalogSubmissions (My Studio round, Sep 2026). Mirrors
       features/my-studio/floor.ts buildSubmission. */
    function catalogSubmissionValid(d) {
      return d.keys().hasOnly(['studioId', 'studioName', 'machineId', 'definition', 'basedOn',
                               'submittedBy', 'submittedByName', 'note', 'status', 'submittedAt',
                               'decidedBy', 'decidedAt', 'decisionNote', 'publishedAs', 'updatedAt'])
          && d.keys().hasAll(['studioId', 'studioName', 'machineId', 'definition', 'submittedBy',
                              'submittedByName', 'note', 'status'])
          && d.studioId is string && d.studioId.size() > 0 && d.studioId.size() <= 80
          && d.studioName is string && d.studioName.size() <= 80
          && d.machineId is string && d.machineId.size() > 0 && d.machineId.size() <= 120
          && d.definition is map
          && (!('basedOn' in d) || d.basedOn == null || (d.basedOn is string && d.basedOn.size() <= 120))
          && d.submittedByName is string && d.submittedByName.size() <= 80
          && d.note is string && d.note.size() <= 500
          && d.status in ['pending', 'published', 'declined', 'withdrawn'];
    }

    function announcementShapeValid(d) {
      return isValidHubAnnouncement(d)
          && d.title is string && d.title.size() <= 200
          && d.shortContent is string && d.shortContent.size() <= 300
          && (!('learningLink' in d) || learningLinkValid(d.learningLink));
    }

    /**
     * The update rule for hub_announcements, extracted so getRole() is called
     * once (via let) instead of 7+ times through canPostAnnouncements /
     * isSuperAdmin / isFranchiseOwnerOnly — each of those calls getRole(),
     * and stacking them blows Firestore's 1000-expression budget.
     * let statements are valid inside function bodies but not in allow conditions.
     */
    /* A studio's own notice (My Studio round, Sep 2026): scoped to one studio,
       and the caller runs that studio (trainerLeads -- a role there, or the
       grant). Never "all", never a network. */
    function studioNoticeOfMine(r, d) {
      return d.get('targetScope', '') == 'studio'
          && d.get('studioId', '') != '' && d.get('studioId', '') != 'all'
          && trainerLeads(r, callerTrainer(), d.studioId);
    }

    function hubAnnouncementUpdateAllowed() {
      let r = getRole();
      return (
        (
          // Everyone who was there is still there, and the
          // only name added is the caller's own.
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['readBy'])
          && request.resource.data.readBy is list
          && request.resource.data.readBy.toSet()
               .hasAll(resource.data.get('readBy', []).toSet())
          && request.resource.data.readBy.toSet()
               .difference(resource.data.get('readBy', []).toSet())
               .hasOnly([request.auth.uid])
        ) || (
          // Lengths are checked on create only, so a notice written before
          // the limits can still be taken down. A studio owner changes only
          // their own notices; the Operations tab's people, any; a studio's
          // leaders, their studio's own (My Studio round). The author and
          // the reach stay what they were allowed to be.
          // Same narrowing as create: a studio owner takes down notices at
          // the studio they run, not at any studio.
          (roleIsSuper(r) || roleIsFranchise(r)
              || studioNoticeOfMine(r, resource.data))
          && (resource.data.get('authorId', '') == request.auth.uid
              || roleIsSuper(r) || roleIsFranchise(r)
              || studioNoticeOfMine(r, resource.data))
          && request.resource.data.get('authorId', '') == resource.data.get('authorId', '')
          && (roleIsSuper(r) || roleIsFranchise(r)
              || !reachesEveryStudio(request.resource.data))
          && isValidHubAnnouncement(request.resource.data)
          && (!('learningLink' in request.resource.data)
              || learningLinkValid(request.resource.data.learningLink))
        )
      );
    }

    /**
     * The hub_announcements create rule, in a function for the same reason as
     * the update rule above: canPostAnnouncements() and the second
     * isSuperAdmin()/isFranchiseOwnerOnly() pair called getRole() about eleven
     * times between them, and every getRole() re-reads the trainer document,
     * which exhausted Firestore's 1000-expression evaluation budget.
     *
     * Permissions are unchanged: for an authenticated caller roleIsSuper(r) is
     * isSuperAdmin(), roleIsFranchise(r) is isFranchiseOwnerOnly(), and the
     * three together are exactly canPostAnnouncements().
     */
    function hubAnnouncementCreateAllowed() {
      let r = getRole();
      // StudioOwner is NOT here on its own. It used to be, from when it was
      // a company-tier role; the My Studio round (Sep 18 2026) made it a
      // STUDIO-tier role -- one studio -- and this line kept the old blanket,
      // so an owner at studio A could post a notice into studio B. They reach
      // their own studio through studioNoticeOfMine, which is what a studio's
      // leaders use: My Studio -> Studio -> Announcements.
      return (roleIsSuper(r) || roleIsFranchise(r)
              || studioNoticeOfMine(r, request.resource.data))
          // Posted as yourself (review fix: the author was free text).
          && request.resource.data.authorId == request.auth.uid
          && (roleIsSuper(r) || roleIsFranchise(r)
              || !reachesEveryStudio(request.resource.data))
          && announcementShapeValid(request.resource.data);
    }

    // ===============================================================
    // COLLECTION ENDPOINTS SECURITY PATHS
    // ===============================================================

    // TRAINERS: Directory search, auth checks, and creation permissions
    //
    // Sep 2026 (Trainer Dossier round) added three guards below the existing
    // role rules, because the trainer document now carries data a tablet has
    // no business writing:
    //
    //   rollups        session counters, maintained by Cloud Functions. A
    //                  client that could set these could invent a career.
    //   mindbody       the staff snapshot the sync owns. Client writes here
    //                  would let a compromised session forge "Mindbody says".
    //   kaizenRoster   a trainer's own tracked-client list. Readable by the
    //                  whole studio team (that is the point), but curated by
    //                  its owner alone -- leadership can change someone's role
    //                  and studio access without editing who they watch.
    //
    // Written as a helper rather than inline so the existing update rule stays
    // legible; `diff().affectedKeys()` is the only way rules can express
    // "you may write this document but not that field".
    function writesDerivedTrainerFields() {
      return request.resource.data.diff(resource.data).affectedKeys()
        .hasAny(['rollups', 'mindbody']);
    }

    // The fields that decide what a person may do and where. A trainer may
    // edit their own document (ownsTrainerDoc) -- their photo, bio, PIN,
    // roster -- but never these: until the cost round (Sep 2026) the
    // self-edit path let anyone hand themselves StudioLeader or FranchiseOwner
    // and any studio, which undid every role check in this file (the hole
    // CLAUDE.md listed as "needs AJ's OK"). Leaders and above still set them
    // for the people they manage, through the other branches of the rule.
    function writesAccessFields() {
      return request.resource.data.diff(resource.data).affectedKeys()
        .hasAny(['role', 'ownedStudioIds', 'accessibleStudioIds', 'activeGuestStudioIds', 'primaryHomeStudioId',
                 'managedStudioIds']);
    }

    /* A role change a caller may make (My Studio round, Sep 2026): none, the
       same role, or one the caller may hand out -- mayHandOut(). Replaces the
       inline "not Founder / Admin / Overseer" clause, which let a studio
       leader promote someone to franchise owner. */
    function roleChangeAllowed(r) {
      return !('role' in request.resource.data)
          || request.resource.data.role == resource.data.get('role', null)
          || mayHandOut(r, request.resource.data.role);
    }

    /* THE GRANT, changed after the fact (My Studio round, Sep 2026). A
       studio's leaders hand out the grant FOR THEIR STUDIO: only studios the
       caller runs may enter or leave managedStudioIds. Administrators and
       franchise owners, any. The studios a caller runs are the home studio
       (with a leader role there), the owned ones and their own grants. */
    function ledStudios(r, t) {
      return (roleIsStudioLeader(r) ? [t.get('primaryHomeStudioId', '')] : [])
          .concat(t.get('ownedStudioIds', []))
          .concat(t.get('managedStudioIds', []));
    }

    function grantChangeAllowed(r, t) {
      let before = resource.data.get('managedStudioIds', []).toSet();
      let after = request.resource.data.get('managedStudioIds', []).toSet();
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny(['managedStudioIds'])
          || roleIsSuper(r) || roleIsFranchise(r)
          || (t != null && after.difference(before).union(before.difference(after)).hasOnly(ledStudios(r, t)));
    }

    // ---------------------------------------------------------------
    // OWNING YOUR OWN TRAINER DOCUMENT (round: trainer identity, Sep 2026)
    //
    // Every rule here used to answer "is this your document?" with
    // request.auth.uid == trainerId. That is only true when the document id
    // IS the auth uid -- and two admin creation paths used addDoc, which
    // assigns a random one. Sign-in then matches those people BY EMAIL
    // (useAuthInitialization), so they arrive holding a document id that no
    // rule will accept, and every write to their own profile is denied. The
    // Kaizen Roster was simply the first place that produced a visible
    // symptom.
    //
    // So ownership is asked properly: the uid, OR the email on the document
    // matching the email in the token. It is the same match the app already
    // performs to hand them the profile in the first place, so this grants no
    // access they were not already being shown.
    //
    // Only valid where `resource` exists -- update and delete, never create.
    //
    // email_verified is deliberately NOT required. Both sign-in paths are
    // OAuth (Google and Microsoft), where the provider has already verified
    // the address, and Microsoft tokens do not reliably carry the claim.
    // REVISIT THIS if password sign-up is ever added: an unverified address
    // would then be self-asserted, and this rule would trust it.
    // ---------------------------------------------------------------
    function ownsTrainerDoc(trainerId) {
      return isAuthenticated() && (
        request.auth.uid == trainerId ||
        (
          request.auth.token.email != null &&
          resource.data.get('email', '') != '' &&
          resource.data.email == request.auth.token.email
        )
      );
    }

    function writesForeignRoster(trainerId) {
      return request.resource.data.diff(resource.data).affectedKeys().hasAny(['kaizenRoster'])
        && !ownsTrainerDoc(trainerId);
    }

    /* THE TRAINER UPDATE RULE, RESOLVED ONCE (Sep 20 2026).
     *
     * This rule blew Firestore's 1000-expression budget, which surfaces as
     * PERMISSION_DENIED and so reads like a rule saying no: a trainer could
     * not edit their own bio. The cause is the documented one. isSuperAdmin(),
     * isFranchiseOwner(), isStudioOwnerOrHeadTrainer(), roleChangeAllowed()
     * and grantChangeAllowed() each re-derived getRole(), and getRole() reads
     * the trainer document TWICE on its document-backed path -- about ten
     * expansions of it in one condition. Demo Mode's extra clause, and its
     * widening of isStudioOwnerOrHeadTrainerOnly, tipped it over.
     *
     * The fix is this file's house pattern: the caller passes getRole() and
     * callerTrainer() in ONCE, and everything below is a pure map lookup
     * against the document already read. trainerLeads() is the sanctioned
     * stand-in for isStudioOwnerOrHeadTrainer() -- it mirrors that helper's
     * DB branch exactly, including the demo studio and the grant. `let` is
     * legal in a function body and not in an `allow` condition, which is why
     * this is a function. See docs/KNOWN-TRAPS.md.
     */
    function trainerUpdateAllowed(trainerId, r, t) {
      let derived = writesDerivedTrainerFields();
      return
        // Demo Mode: re-seeding rewrites the three demo trainers whole. Both
        // the stored document and the incoming one have to be demo documents,
        // so a real trainer can never be turned into one, nor the reverse.
        // The free literal tests lead, so an ordinary profile edit abandons
        // this clause on its first expression.
        (request.resource.data.get('isDemo', false) == true &&
         trainerId.matches('demo-trainer-.*') &&
         resource.data.get('isDemo', false) == true &&
         t != null &&
         isDemoTrainerPayload(trainerId, request.resource.data)) ||
        (roleIsSuper(r) && !derived) ||
        ( !derived &&
          !writesForeignRoster(trainerId) &&
          ( roleIsFranchise(r) ||
            trainerLeads(r, t, resource.data.get('primaryHomeStudioId', null)) ||
            (ownsTrainerDoc(trainerId) && !writesAccessFields())
          ) &&
          roleChangeAllowed(r) && grantChangeAllowed(r, t)
        );
    }

    /* PLANNER NOTES (Learning + Planner round, Sep 2026). The limits match
       src/features/planner/notes/types.ts. These are shape checks on a
       trainer's OWN documents — privacy is the path, below — so a bad write
       from an old app version cannot leave a note the Planner cannot read. */
    function noteKindValid(k) {
      return k in ['note', 'plan', 'routine', 'retention', 'injury', 'research'];
    }

    /* Planner rework (Sep 2026): sources travel with a note; the working log
       and the colleague-share marker live only on the private note. All
       three are optional, so a note written by an older app still passes. */
    function noteExtrasValid(d) {
      return (!('links' in d) || (d.links is list && d.links.size() <= 10))
          && (!('log' in d) || (d.log is list && d.log.size() <= 100))
          && (!('teamShare' in d) || d.teamShare == null || d.teamShare is map);
    }

    function trainerNoteValid(d) {
      return d.keys().hasOnly(['title', 'body', 'kind', 'folderId', 'clientIds', 'clientNames',
                               'pinned', 'sharedWith', 'createdAt', 'updatedAt',
                               'links', 'log', 'teamShare'])
          && noteExtrasValid(d)
          && d.keys().hasAll(['title', 'body', 'kind', 'folderId', 'clientIds', 'clientNames',
                              'pinned', 'sharedWith', 'createdAt', 'updatedAt'])
          && d.title is string && d.title.size() > 0 && d.title.size() <= 160
          && d.body is string && d.body.size() <= 10000
          && noteKindValid(d.kind)
          && (d.folderId == null || (d.folderId is string && d.folderId.size() <= 200))
          && d.clientIds is list && d.clientIds.size() <= 10
          && d.clientNames is map && d.clientNames.size() <= 10
          && d.pinned is bool
          // Shared means about exactly that one client -- the same rule the
          // Planner enforces, so a copy can never carry other clients' names.
          && (d.sharedWith == null || (d.sharedWith is string
                                       && d.clientIds.size() == 1
                                       && d.clientIds[0] == d.sharedWith))
          && d.createdAt is timestamp
          && d.updatedAt is timestamp;
    }

    function noteFolderValid(d) {
      return d.keys().hasOnly(['name', 'createdAt', 'updatedAt'])
          && d.keys().hasAll(['name', 'createdAt', 'updatedAt'])
          && d.name is string && d.name.size() > 0 && d.name.size() <= 60
          && d.createdAt is timestamp
          && d.updatedAt is timestamp;
    }

    /* A shared note's copy on a client's record. Signed by the caller and
       stamped with this write's time, so neither can be faked; the whole
       document is checked on every write (the app always overwrites it). */
    function sharedNoteValid(d, clientId) {
      return d.keys().hasOnly(['clientId', 'title', 'body', 'kind', 'authorId', 'authorName', 'updatedAt', 'links'])
          && (!('links' in d) || (d.links is list && d.links.size() <= 10))
          && d.keys().hasAll(['clientId', 'title', 'body', 'kind', 'authorId', 'authorName', 'updatedAt'])
          && d.clientId == clientId
          && d.title is string && d.title.size() > 0 && d.title.size() <= 160
          && d.body is string && d.body.size() <= 10000
          && noteKindValid(d.kind)
          && d.authorId == request.auth.uid
          && d.authorName is string && d.authorName.size() <= 80
          && d.updatedAt == request.time;
    }

    /* A TEAM JOB (Planner rework, Sep 2026). Limits match
       src/features/planner/jobs/types.ts. Shape only: who may write what is
       in the match block. */
    function teamJobValid(d, studioId) {
      return d.studioId == studioId
          && d.title is string && d.title.size() > 0 && d.title.size() <= 160
          && (!('detail' in d) || (d.detail is string && d.detail.size() <= 2000))
          && d.status in ['open', 'done', 'cancelled']
          && d.createdBy is map && d.createdBy.id is string
          && d.assignees is list && d.assignees.size() <= 30
          && d.assigneeIds is list && d.assigneeIds.size() <= 30
          && d.parts is map && d.parts.size() <= 60
          && (!('closingNote' in d) || d.closingNote == null
              || (d.closingNote is string && d.closingNote.size() <= 1000))
          && (!('dueOn' in d) || d.dueOn == null || d.dueOn is string);
    }

    /* WHO MAY POST, EDIT OR CALL OFF A TEAM JOB.
       Extracted for the same reason as the hub_announcement rules above, and
       it is the same failure: the inline version asked isSuperAdmin(), then
       isFranchiseOwnerOnly(), then isStudioOwnerOrHeadTrainer(studioId), and
       every one of those calls getRole() -- which reads the trainer document
       TWICE on the document-backed path -- while isStudioOwnerOrHeadTrainerOnly
       calls getRole() three more times and getTrainerData() five. One update
       evaluated its way through Firestore's 1000-expression budget and came
       back "Unable to evaluate the expression as the maximum of 1000
       expressions to evaluate has been reached", which reads as a permission
       error and is not one. Resolving the role and the trainer document once
       is the whole fix.

       trainerLeads() is also the RIGHT question: it is the one app-side answer
       to "runs this studio" (features/relay/leads.ts mirrors it), and it counts
       Trainer.managedStudioIds -- the grant the My Studio round added. */
    function teamJobLeaderAllowed(studioId) {
      let r = getRole();
      return roleIsSuper(r) || roleIsFranchise(r)
          || trainerLeads(r, callerTrainer(), studioId);
    }

    /* MACHINE CARE (Relay, Sep 2026). Shape only; limits match
       src/features/planner/relay/machine-care.ts. Times are millisecond
       numbers (they sit inside merged writes, where serverTimestamp would
       be fine but a number compares in the app without a round trip). */
    function careActorValid(a) {
      return a == null || (a is map && a.id is string && a.name is string && a.name.size() <= 80);
    }
    function machineCareValid(d, machineId) {
      return d.keys().hasOnly(['machineId', 'lastWipedAt', 'lastWipedBy', 'lastDeepCleanAt',
                               'lastDeepCleanBy', 'flag', 'updatedAt'])
          && d.machineId == machineId
          && (!('lastWipedAt' in d) || d.lastWipedAt == null || d.lastWipedAt is number)
          && (!('lastDeepCleanAt' in d) || d.lastDeepCleanAt == null || d.lastDeepCleanAt is number)
          && (!('lastWipedBy' in d) || careActorValid(d.lastWipedBy))
          && (!('lastDeepCleanBy' in d) || careActorValid(d.lastDeepCleanBy))
          && (!('flag' in d) || d.flag == null
              || (d.flag is map
                  && d.flag.note is string && d.flag.note.size() > 0 && d.flag.note.size() <= 500
                  && d.flag.by is map && d.flag.by.id is string
                  && d.flag.at is number
                  /* A new flag is signed by the caller; a wipe merged over
                     someone else's standing flag leaves it as it was. */
                  && (d.flag.by.id == request.auth.uid
                      || (resource != null && resource.data.get('flag', null) == d.flag))));
    }

    /* THE MACHINE-FIT INDEX (machine fit, Sep 2026): who at a studio is set
       to what on one machine. Shape only -- a row is keyed by a client id the
       rules cannot enumerate, so what a write may TOUCH is checked at the
       match block (one row at a time). */
    function machineFitValid(d, studioId, machineId) {
      return d.keys().hasOnly(['machineId', 'studioId', 'rows', 'updatedAt', 'rebuiltAt'])
          && d.machineId == machineId
          && d.studioId == studioId
          // `get`, not `d.rows`: REMOVING a client's row from a machine that
          // has no index document yet creates one with no `rows` at all, and
          // reading a missing property is an error, which refused the write --
          // and, inside the Setup screen's batch, every other row with it.
          && d.get('rows', {}) is map;
    }

    /* A NOTE SHARED WITH COLLEAGUES (Planner rework, Sep 2026). Signed by
       the caller and stamped with this write's time; limits match
       src/features/planner/notes/team-share.ts and notes/types.ts. */
    function noteShareValid(d, studioId, noteId) {
      return d.keys().hasOnly(['noteId', 'studioId', 'authorId', 'authorName', 'title', 'body', 'kind',
                               'links', 'clientIds', 'clientNames', 'audience', 'audienceIds',
                               'expiresOn', 'message', 'updatedAt'])
          && d.keys().hasAll(['noteId', 'studioId', 'authorId', 'authorName', 'title', 'body', 'kind',
                              'links', 'clientIds', 'clientNames', 'audience', 'audienceIds',
                              'expiresOn', 'message', 'updatedAt'])
          && d.noteId == noteId
          && d.studioId == studioId
          && d.authorId == request.auth.uid
          && d.authorName is string && d.authorName.size() <= 80
          && d.title is string && d.title.size() > 0 && d.title.size() <= 160
          && d.body is string && d.body.size() <= 10000
          && noteKindValid(d.kind)
          && d.links is list && d.links.size() <= 10
          && d.clientIds is list && d.clientIds.size() <= 10
          && d.clientNames is map && d.clientNames.size() <= 10
          && d.audience in ['people', 'team']
          && d.audienceIds is list && d.audienceIds.size() <= 20
          && (d.audience == 'team' || d.audienceIds.size() > 0)
          && (d.expiresOn == null || d.expiresOn is string)
          && d.message is string && d.message.size() <= 300
          && d.updatedAt == request.time;
    }

    /* STUDIO CONTENT WRITES (Learning + Planner round, Sep 2026).
       Someone who works at, or runs, this studio -- or an administrator or a
       franchise owner. Before this round the machine notes, upkeep log,
       playbook and wiki blocks below accepted any signed-in trainer at ANY
       studio (their comments said the path enforced tenancy; nothing checked
       the path). Now the path does. */
    function writesForStudio(studioId) {
      return isSuperAdmin() || isFranchiseOwnerOnly() || isTrainerOfStudio(studioId);
    }

    /* The "Share with all MSF studios" fields on a playbook tip or a machine
       note (features/machine-db). Shape only: whether it may be shared is
       the same question as whether it may be edited. */
    function sharedFieldsValid(d) {
      return (!('shared' in d) || d.shared is bool)
          && (!('sharedKeys' in d) || (d.sharedKeys is list && d.sharedKeys.size() <= 10))
          && (!('studioName' in d) || (d.studioName is string && d.studioName.size() <= 80));
    }

    /* Only a studio's OWN machine can be listed in the database: a catalog
       entry is already in it, and a copy adopted from another studio is
       listed by its original. */
    function rosterShareValid(d) {
      return d.get('shared', false) != true
          || (d.get('source', '') == 'custom' && !('adoptedFrom' in d));
    }

    /* ...and a copy stays a copy: an update can't drop `adoptedFrom` and list
       it in the same write (review fix). The studio it names is the one its
       path names, so a shared machine can't claim another studio. */
    function rosterWriteValid(studioId) {
      return rosterShareValid(request.resource.data)
          && request.resource.data.get('studioId', studioId) == studioId
          && (resource == null
              || !('adoptedFrom' in resource.data)
              || request.resource.data.get('shared', false) != true);
    }

    /* A comment on a Learning page (features/comments). No client field
       exists to fill: hasOnly is the guard, as on the playbook and wiki. */
    function commentValid(d, studioId) {
      return d.keys().hasOnly(['studioId', 'targetKey', 'target', 'body', 'authorId',
                               'authorName', 'mentions', 'createdAt', 'editedAt'])
          && d.keys().hasAll(['studioId', 'targetKey', 'target', 'body', 'authorId',
                              'authorName', 'mentions', 'createdAt'])
          && d.studioId == studioId
          && d.targetKey is string && d.targetKey.size() > 0 && d.targetKey.size() <= 300
          && d.target is map
          && d.body is string && d.body.size() > 0 && d.body.size() <= 2000
          && d.authorId is string
          && d.authorName is string && d.authorName.size() <= 80
          && d.mentions is list && d.mentions.size() <= 10
          && d.createdAt is timestamp;
    }

    match /trainers/{trainerId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && 
                    request.resource.data.primaryHomeStudioId != null &&
                    isValidTrainer(request.resource.data) &&
                    (isSuperAdmin() ||
                     // My Studio round (Sep 2026): what an approval may hand
                     // out follows the approver -- a franchise owner never
                     // mints an administrator, a studio's leaders never mint
                     // an owner (mayHandOut), and a studio leader's grant can
                     // only name the studio the new person is joining.
                     (isFranchiseOwner() && !roleIsSuper(request.resource.data.get('role', null))) ||
                     // Demo Mode (Sep 20 2026): demo-studio is NOT a door here.
                     // hasRunOfDemo() makes isStudioOwnerOrHeadTrainer true for
                     // EVERYBODY inside demo-studio, and this clause never
                     // constrains accessibleStudioIds or ownedStudioIds -- so
                     // without this guard any signed-in trainer could mint a
                     // trainer document claiming access to a REAL studio, at
                     // any id, including a colleague's uid before they first
                     // sign in. Demo trainers are created by the
                     // isDemoTrainerPayload clause below and nowhere else.
                     (!isDemoStudioId(request.resource.data.primaryHomeStudioId) &&
                      isStudioOwnerOrHeadTrainer(request.resource.data.primaryHomeStudioId) &&
                      studioTierRole(request.resource.data.get('role', null)) &&
                      request.resource.data.get('managedStudioIds', []).hasOnly([request.resource.data.primaryHomeStudioId])) ||
                     // Bootstrap / claim: a person may own trainers/{their uid},
                     // but may not hand themselves Admin, Founder or Overseer.
                     // See selfCreatedRoleIsAllowed() above.
                     (request.auth.uid == trainerId && selfCreatedRoleIsAllowed()) ||
                     // Demo Mode (Sep 20 2026). The seeder's three demo
                     // trainers have no Auth account, so they cannot be minted
                     // by the bootstrap clause above, and the studio they join
                     // has no leaders of its own to approve them. Pinned hard
                     // by isDemoTrainerPayload -- see the demo helpers.
                     (isAnyAuthenticatedTrainer() &&
                      isDemoTrainerPayload(trainerId, request.resource.data)));
      allow update: if isAuthenticated() &&
                       trainerUpdateAllowed(trainerId, getRole(), callerTrainer());
      allow delete: if isSuperAdmin();

      match /secrets/account {
        allow read: if isSuperAdmin() || request.auth.uid == trainerId || 
            (exists(/databases/$(database)/documents/trainers/$(trainerId)) && 
             isStudioOwnerOrHeadTrainer(get(/databases/$(database)/documents/trainers/$(trainerId)).data.primaryHomeStudioId));
        allow write: if isSuperAdmin() || request.auth.uid == trainerId || 
            (exists(/databases/$(database)/documents/trainers/$(trainerId)) && 
             isStudioOwnerOrHeadTrainer(get(/databases/$(database)/documents/trainers/$(trainerId)).data.primaryHomeStudioId));
      }

      // PERSONAL TASKS — a trainer's own to-do list (Sep 2026).
      //
      // Deliberately a separate PATH rather than a `scope` field on the shared
      // studios/{id}/task* collections. Rules cannot enforce "only your own
      // rows" on a LIST query unless every query carries a matching
      // constraint, so privacy would rest on every future query being written
      // correctly, and one unconstrained read added later would leak every
      // trainer's private list at once. Here it is structural: the uid in the
      // path IS the tenancy.
      //
      // trainerId is the Firebase Auth uid, which is why this compares against
      // request.auth.uid directly and costs no document read. Not even a
      // studio owner can read these: a private list is private, and the
      // shared list is where anything a manager needs to see belongs.
      match /taskTemplates/{templateId} {
        allow read, write: if isAuthenticated() && request.auth.uid == trainerId;
      }

      match /taskInstances/{instanceId} {
        allow read, write: if isAuthenticated() && request.auth.uid == trainerId;
      }

      // PLANNER NOTES (Learning + Planner round, Sep 2026) -- a trainer's own
      // notes and folders. Private by PATH, for the same reason as the task
      // lists above, and more so: a note can name a client and describe an
      // injury. Nobody else reads these, a studio owner included. A note the
      // author wants the team to see is COPIED onto the client's record
      // (clients/{id}/sharedNotes, below); this tree never opens up.
      match /notes/{noteId} {
        allow read, delete: if isAuthenticated() && request.auth.uid == trainerId;
        allow create, update: if isAuthenticated() && request.auth.uid == trainerId
                              && trainerNoteValid(request.resource.data);
      }

      match /noteFolders/{folderId} {
        allow read, delete: if isAuthenticated() && request.auth.uid == trainerId;
        allow create, update: if isAuthenticated() && request.auth.uid == trainerId
                              && noteFolderValid(request.resource.data);
      }

      // IN-APP NOTIFICATIONS (round: Settings tiers & Task Board, Sep 2026).
      //
      // The one place in this file where a signed-in user writes into ANOTHER
      // user's document tree, so it is worth being explicit about why and
      // about what that does and does not allow.
      //
      // Why: notifications are written client-side, by the device of whoever
      // completed the task or replied to the request. That keeps the feature
      // free of Cloud Functions like the rest of studio-tasks — no deploy
      // step, no cold start, nothing riding on the Cloud Run pipeline.
      //
      // What it allows: CREATE only. A caller cannot read, update or delete
      // anyone else's notifications, cannot attribute one to a colleague
      // (actor.id is pinned to request.auth.uid), and cannot create one that
      // is already marked read — so nobody can slip a notification past a
      // recipient's badge. The worst a bad actor can do is put a truthfully
      // attributed line in a colleague's bell, which is the feature.
      //
      // Reading, marking read and deleting are the owner's alone, by uid in
      // the path, exactly like the private task lists above.
      match /notifications/{notificationId} {
        allow read, update, delete:
          if isAuthenticated() && request.auth.uid == trainerId;

        allow create: if isAuthenticated()
                      && isAnyAuthenticatedTrainer()
                      && request.resource.data.actor.id == request.auth.uid
                      && request.resource.data.kind is string
                      && request.resource.data.title is string
                      && request.resource.data.title.size() <= 200
                      && request.resource.data.readAt == null;
      }

    }

    // CLIENTS — scoped to the reader's studios (tenancy pass, Sep 2026)
    //
    // This rule used to be `allow read: if isAuthenticated()`. Any trainer at
    // any studio could read every client record in the platform — name, date
    // of birth, phone, email, clinical notes — for every other franchise.
    //
    // The machinery to prevent that was already in this file and had never
    // been wired to this collection. `isTrainerOfClientData` encodes exactly
    // the policy lib/permissions.ts implements: your own studios, plus a
    // client who has explicitly approved cross-training at one of them.
    //
    // READ IS WIDER THAN WRITE, DELIBERATELY. A cross-train client's record
    // has to be readable at the studio they are visiting — that is what makes
    // them trainable there — but editing them stays with the studio that owns
    // the relationship. A visiting trainer correcting a phone number on
    // someone else's client is how two studios end up disagreeing about who a
    // person is.
    //
    // NOTE ON QUERIES: Firestore evaluates this per document and rejects a
    // whole query if any document it would return fails. So every list query
    // against this collection must be constrained to the reader's studios.
    // The unscoped ones were fixed alongside this rule — see the tenancy
    // section of ADMIN-OVERHAUL-ROUND2.md.
    match /clients/{clientId} {
      allow read: if isSuperAdmin()
                  || isFranchiseOwnerOnly()
                  || (isAnyAuthenticatedTrainer()
                      && isTrainerOfClientData(
                           clientId,
                           resource.data,
                           getTrainerData().primaryHomeStudioId,
                           getTrainerData().get('accessibleStudioIds', []),
                           getTrainerData().get('activeGuestStudioIds', [])));

      // `renewal` is the renewal snapshot (Renewals round, Sep 2026). Only
      // the nightly job writes it, through the Admin SDK, which these rules
      // do not govern. Nobody writes it from the app — not even an admin — so
      // an iPad holding an old copy of the client can never put it back.
      allow create: if isValidClient(request.resource.data)
                    && !('renewal' in request.resource.data)
                    && (isSuperAdmin()
                        || (isAnyAuthenticatedTrainer()
                            && isTrainerOfStudio(
                                 getStudioIdFromData(request.resource.data))));

      // `resource.data` is the EXISTING document: a trainer may only edit a
      // client their own studio holds, whatever the incoming payload claims.
      //
      // The one exception is a CROSS-TRAIN VISITOR's session (Sep 24 2026).
      // A trainer at a studio the client is approved to train at
      // (approvedCrossTrainStudioIds, the same list that lets them read the
      // client) may move exactly the totals a session moves, and the summary
      // of a Pulse they finish, and nothing else: not the name, the home
      // studio, the approval list, the notes or the medical history.
      // Without it a visitor's Finish was refused in
      // full and the session never ended (docs/KNOWN-TRAPS.md, cross-train).
      // Checked before the home-studio test so the visitor's path stays cheap
      // inside a finish batch of eight machines.
      allow update: if isValidClient(request.resource.data)
                    && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['renewal'])
                    && (isSuperAdmin()
                        || crossTrainSessionTotals(resource.data, callerTrainer())
                        || (isAnyAuthenticatedTrainer()
                            && isTrainerOfStudio(
                                 getStudioIdFromData(resource.data))));

      allow delete: if isSuperAdmin();
    }

    // INBODY SCANS (Renewals round, Sep 2026) -- see the helpers above.
    //
    // Anyone who can write the client can add a scan or correct a typo in
    // one (the correction is signed: updatedBy). Who entered it, when, and
    // from where never change. A scan entered by mistake can be removed by
    // whoever entered it or by the studio's leaders.
    match /clients/{clientId}/inbodyScans/{scanId} {
      allow read: if isAuthenticated() && (
                    roleIsSuper(getRole()) || roleIsFranchise(getRole()) ||
                    sessionClientIsReadable(clientId, getRole(), callerTrainer()));

      allow create: if isAuthenticated()
                    && inbodyWritable(clientId, getRole(), callerTrainer())
                    && inbodyScanValid(request.resource.data)
                    && request.resource.data.enteredBy == request.auth.uid
                    && request.resource.data.enteredByName is string
                    && request.resource.data.enteredByName.size() <= 80
                    && request.resource.data.source in ['manual', 'photo']
                    && request.resource.data.studioId is string
                    && request.resource.data.createdAt == request.time;

      allow update: if isAuthenticated()
                    && inbodyWritable(clientId, getRole(), callerTrainer())
                    && inbodyScanValid(request.resource.data)
                    && !request.resource.data.diff(resource.data).affectedKeys()
                         .hasAny(['enteredBy', 'enteredByName', 'createdAt', 'source', 'studioId'])
                    && request.resource.data.updatedBy == request.auth.uid
                    && request.resource.data.updatedAt == request.time;

      allow delete: if isAuthenticated()
                    && inbodyWritable(clientId, getRole(), callerTrainer()) && (
                      resource.data.get('enteredBy', '') == request.auth.uid ||
                      isSuperAdmin() ||
                      isStudioOwnerOrHeadTrainerOnly(inbodyClientStudio(clientId)));
    }

    // SHARED NOTES (Learning + Planner round, Sep 2026) -- a note a trainer
    // shared from their Planner, copied onto the client's record. Shown in
    // the profile under Goals -> Plans from the team.
    //
    // Read like InBody scans: whoever can open the client. Written like one
    // too (inbodyWritable): putting something on a client's record is for
    // the studio that holds them. Only the author rewrites a copy -- the
    // app overwrites it whole on every save, so the full shape is checked.
    //
    // Delete: the author, always (it is theirs to take back, even after
    // moving studio); the studio's leaders and administrators (someone has
    // to be able to take a note off a record). `resource == null` lets the
    // author's Planner delete a copy a leader already removed, in the same
    // batch as the note itself, without the whole batch being refused.
    match /clients/{clientId}/sharedNotes/{noteId} {
      allow read: if isAuthenticated() && (
                    roleIsSuper(getRole()) || roleIsFranchise(getRole()) ||
                    sessionClientIsReadable(clientId, getRole(), callerTrainer()));

      allow create: if isAuthenticated()
                    && inbodyWritable(clientId, getRole(), callerTrainer())
                    && sharedNoteValid(request.resource.data, clientId);

      allow update: if isAuthenticated()
                    && inbodyWritable(clientId, getRole(), callerTrainer())
                    && resource.data.get('authorId', '') == request.auth.uid
                    && sharedNoteValid(request.resource.data, clientId);

      allow delete: if isAuthenticated() && (
                      resource == null ||
                      resource.data.get('authorId', '') == request.auth.uid ||
                      isSuperAdmin() ||
                      isStudioOwnerOrHeadTrainerOnly(inbodyClientStudio(clientId)));
    }

    // DISK SETTINGS: Machine settings assigned to specific athletes
    //
    // Delete was `isSuperAdmin() || isFranchiseOwner() || isAuthenticated()`
    // until Sep 20 2026. The trailing clause made the first two decorative:
    // ANY signed-in Google account could delete any client's machine settings
    // — including someone sitting in AccessRequestView with no trainer profile
    // at all, who could enumerate them first through the open read above.
    // It now matches create and update: a trainer, and nothing less.
    match /clientMachineSettings/{settingId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && isAnyAuthenticatedTrainer();
      allow update: if isAuthenticated() && isAnyAuthenticatedTrainer();
      allow delete: if isAuthenticated() && isAnyAuthenticatedTrainer();
    }

    // GLOBAL MACHINE CATALOG — the default set every studio picks from
    // (round: Machine Creator & Studio Roster, Sep 2026).
    //
    // Writes are "admins and above" only. Franchise owners are deliberately
    // NOT included: a studio inherits every catalog field it has not
    // explicitly overridden, so an edit here still reaches most trainers at
    // most locations. Studio-level customization belongs in the studio's own
    // roster below, where it affects exactly one location.
    //
    // Deletes are denied outright. A retired machine keeps its document
    // (status: 'retired') because studios may still physically own it and
    // every exerciseLog ever written references its id.
    match /machines/{machineId} {
      allow read: if isAuthenticated();
      allow create, update: if isSuperAdmin();
      allow delete: if false;

      // The audit trail for a machine's settings: who changed what, when and
      // why (features/equipment/mutations.ts writeHistory, machine-fit
      // setup-save.ts). It is written with addDoc and never updated or
      // deleted by any code in the app, so the rule now says exactly that.
      //
      // Until Sep 20 2026 this was `allow read, write: if isAuthenticated()`
      // — any signed-in account could rewrite or erase the trail. An audit
      // trail anyone can edit is not an audit trail.
      match /settingHistory/{historyId} {
        allow read: if isAuthenticated();
        allow create: if isAuthenticated() && isAnyAuthenticatedTrainer();
        allow update, delete: if false;
      }
    }

    match /machineSettingChanges/{changeId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && isAnyAuthenticatedTrainer();
    }

    // ROUTINES & ADJUSTMENTS
    match /routines/{routineId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && isAnyAuthenticatedTrainer();
      allow update: if isAuthenticated() && isAnyAuthenticatedTrainer();
      allow delete: if isSuperAdmin() || isFranchiseOwner();
    }

    match /routineAdjustments/{adjustmentId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && isAnyAuthenticatedTrainer();
    }

    // ROUTINE PRESETS — two tiers: built-in "global" presets ship in app
    // code (data/routine-presets.ts, never written here), studio presets
    // are docs with studioId == the trainer's studio. Same posture as the
    // routines/routineAdjustments blocks above (isolation is client-side
    // pending the pre-launch security hardening pass).
    // ROUTINE TEMPLATES / PRESETS — three tiers sharing one collection
    // (round: Routine Template Builder, Sep 2026).
    //
    //   company  admin-authored, every studio sees it -> isSuperAdmin()
    //   studio   one location's own template          -> that studio's owner
    //                                                    or leader, or admin
    //   trainer  ad-hoc, saved from the routine drawer-> any trainer
    //
    // `tier` is ABSENT on every document written before Sep 2026, so it is
    // always read through .get('tier', 'trainer'): those documents keep
    // exactly the permissions they had, and nothing needs backfilling
    // before this deploys.
    //
    // Update deliberately checks BOTH the stored document and the incoming
    // one. Checking only the incoming would let a trainer relabel their own
    // preset as a company standard; checking only the stored one would let
    // an admin's template be downgraded and then edited by anyone. The write
    // has to be legal at the tier it comes from AND the tier it lands on.
    function presetTier(data) {
      return data.get('tier', 'trainer');
    }

    function canWritePreset(data) {
      return (presetTier(data) == 'company' && isSuperAdmin()) ||
             (presetTier(data) == 'studio' && (
                isSuperAdmin() ||
                isStudioOwnerOrHeadTrainer(data.get('studioId', ''))
             )) ||
             (presetTier(data) == 'trainer' && isAnyAuthenticatedTrainer());
    }

    match /routinePresets/{presetId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && canWritePreset(request.resource.data);
      allow update: if isAuthenticated() &&
                       canWritePreset(resource.data) &&
                       canWritePreset(request.resource.data);
      allow delete: if isAuthenticated() && canWritePreset(resource.data);
    }

    // STUDIO MACHINE SETTINGS — SUPERSEDED by studios/{id}/roster/{machineId}
    // above. Kept live until the backfill runs and call sites move over
    // (phase 4, Machine Creator & Studio Roster). Do not build anything new
    // on this collection.
    //
    // Original note: per-studio overrides (which equipment a
    // studio owns, its custom display order, its own setting-card options)
    // layered on top of the shared global machines/{id} catalog doc, which
    // stays untouched. Doc id convention: {studioId}_{machineId}. Same
    // deliberately unhardened posture as routinePresets above, pending the
    // pre-launch security hardening pass already tracked in ROADMAP.md.
    match /studioMachineSettings/{settingId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && isAnyAuthenticatedTrainer();
      allow update: if isAuthenticated() && isAnyAuthenticatedTrainer();
      allow delete: if isAuthenticated() && isAnyAuthenticatedTrainer();
    }

    // TRAINING SESSIONS — scoped three ways (tenancy pass, Sep 2026)
    //
    // This was `allow read: if isAuthenticated()`, so every trainer could read
    // every session ever recorded anywhere: which client, which trainer, what
    // weight, what notes.
    //
    // WHY THREE BRANCHES RATHER THAN A STUDIO CHECK
    // ---------------------------------------------
    // The obvious rule — "the session's studio is one of mine" — is wrong here
    // for two reasons the code makes plain.
    //
    // First, eighteen read paths query sessions by `clientId`, not by studio:
    // a client's history, their charts, their progress report, their machine
    // stats. Scoping those by studio would silently truncate the history of
    // any client who has ever trained at a second location — and cross-training
    // is a feature of this product, not an edge case.
    //
    // Second, sessions written before `hostedAtStudioId` was enforced carry
    // "", "unknown", "legacy" or nothing at all. A studio-only rule would make
    // those documents unreadable by every single user, including the owner,
    // and would poison any query that could return one.
    //
    // So the question the rule asks is the one the app actually asks: can this
    // trainer read the CLIENT? That is `isTrainerOfClient`, the same predicate
    // guarding the client record itself, so a session can never be more
    // visible than the person it is about. The studio branch covers a session
    // at my location whose client record is gone; the trainer branch covers my
    // own history after I move studios.
    //
    // COST: for a `clientId`-pinned query every document resolves the same
    // client path, which Firestore caches within one evaluation — two document
    // reads for the whole query, against a limit of ten.
    match /sessions/{sessionId} {
      // Caller resolved ONCE and passed down; see the expression-budget
      // helpers above. Same policy as before, ~1/10th the expression count.
      allow read: if isAuthenticated()
                  && sessionIsReadable(resource.data, getRole(), callerTrainer());

      allow create: if isValidSession(request.resource.data)
                    && (isSuperAdmin()
                        || (isAnyAuthenticatedTrainer()
                            && (isTrainerOfStudio(
                                  request.resource.data.get('hostedAtStudioId', ''))
                                || namedClientIsReadable(
                                     request.resource.data.get('clientId', '')))));

      allow update: if isValidSession(request.resource.data)
                    && (isSuperAdmin()
                        || (isAnyAuthenticatedTrainer()
                            && (resource.data.get('trainerId', '') == request.auth.uid
                                || isTrainerOfStudio(
                                     resource.data.get('hostedAtStudioId', ''))
                                || namedClientIsReadable(
                                     resource.data.get('clientId', '')))));

      /* Deleting a session is the same reach as editing one (Sep 17 2026).
         It was super-admin-and-owner only, which meant a trainer who logged a
         past session onto the wrong client could not take it back off, and the
         History tab's Delete button failed halfway through its batch. Same
         three tests as `update`, read off the STORED document. */
      allow delete: if isSuperAdmin()
                    || isFranchiseOwner()
                    || (isAnyAuthenticatedTrainer()
                        && (resource.data.get('trainerId', '') == request.auth.uid
                            || isTrainerOfStudio(
                                 resource.data.get('hostedAtStudioId', ''))
                            || namedClientIsReadable(
                                 resource.data.get('clientId', ''))));

      // The logs hang off a session whose parent rule has already been
      // evaluated to reach this path in the UI, but a client can address them
      // directly, so they carry the same client check rather than trusting it.
      match /logs/{logId} {
        allow read, write: if isSuperAdmin()
                           || (isAnyAuthenticatedTrainer()
                               && isTrainerOfSessionId(sessionId));
      }
    }

    // EXERCISE LOGS — KEY FIX: Any authenticated trainer can write exercise logs
    match /exerciseLogs/{logId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && isAnyAuthenticatedTrainer() && isValidLog(request.resource.data);
      allow update: if isAuthenticated() && isAnyAuthenticatedTrainer() && isValidLog(request.resource.data) && (
        resource.data.get('sessionId', null) == request.resource.data.get('sessionId', null) &&
        resource.data.get('clientId', null) == request.resource.data.get('clientId', null)
      );
      /* HISTORY EDITING (Sep 17 2026). Taking a machine off a session that
         already happened means deleting its set, and only a super admin or a
         franchise owner could — so "remove this machine", and the History
         tab's own Delete Session, both failed for the people who work the
         floor. The update rule above already lets any signed-in trainer blank
         any log, so delete grants no reach update did not; it just stops
         leaving an empty row behind where a machine used to be. */
      allow delete: if isSuperAdmin() || isFranchiseOwner()
                    || (isAuthenticated() && isAnyAuthenticatedTrainer());
    }

    // CALENDAR SCHEDULES
    match /schedules/{scheduleId} {
      allow read: if isAuthenticated();
      allow create, update: if isAuthenticated() && (
        isFranchiseOwner() || 
        isSuperAdmin() ||
        isAnyAuthenticatedTrainer()
      ) && isValidSchedule(request.resource.data);
      allow delete: if isSuperAdmin() || isFranchiseOwner() || isAnyAuthenticatedTrainer();
    }
    
    // CLINICAL NOTES
    match /sessionNotes/{noteId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && isAnyAuthenticatedTrainer();
      allow update: if isAuthenticated() && isAnyAuthenticatedTrainer();
      allow delete: if isSuperAdmin() || isFranchiseOwner();
    }

    match /users/{userId} {
      allow read, write: if isSuperAdmin() || request.auth.uid == userId;
    }

    
    // AUDIT LOGS
    match /auditLogs/{logId} {
      allow read: if isSuperAdmin() || isFranchiseOwner();
      allow create: if isAuthenticated();
      allow update, delete: if isSuperAdmin();
    }
  
    // Written by the weekly machine-trends job (server/machine-trends-job.ts,
    // service account, bypasses these rules). Aggregates only - never a
    // client row - so it is readable like exerciseLogs, by any signed-in user.
    // The old leaderboards/* documents are no longer written; the block
    // stays so the stale documents can still be deleted from the console.
    match /machineTrends/{machineId} {
      allow read: if isAuthenticated();
      allow write: if isSuperAdmin();
    }

    // THE KAIZEN REPORT (machine fit, Sep 2026) -- the weekly job's company-wide
    // view of how each machine is set up: every studio beside the company, and
    // how many of a studio's set-ups sit far from what similar clients use.
    // That is management information about named studios, so unlike
    // machineTrends it is for administrators, founders and overseers only.
    // Counts only, never a client row. Written by the job (Admin SDK).
    match /kaizenReports/{machineId} {
      allow read: if isSuperAdmin();
      allow write: if false;
    }

    match /leaderboards/{docId} {
      allow read: if isAuthenticated();
      allow write: if isSuperAdmin();
    }

    // SPECIAL ATHLETE FOCUS PATTERNS
    match /trainerFocuses/{focusId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && isAnyAuthenticatedTrainer();
      allow update: if isAuthenticated() && isAnyAuthenticatedTrainer();
      allow delete: if isSuperAdmin() || isFranchiseOwner();
    }

    match /progressReports/{reportId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && isAnyAuthenticatedTrainer();
      allow update: if isAuthenticated() && isAnyAuthenticatedTrainer();
      allow delete: if isSuperAdmin() || isFranchiseOwner();
    }

    match /focusRecords/{focusId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && isAnyAuthenticatedTrainer();
      allow update: if isAuthenticated() && isAnyAuthenticatedTrainer();
      allow delete: if isSuperAdmin() || isFranchiseOwner();
    }

    // ================================================================
    // UNIFIED COACHING JOURNAL (Sep 2026)
    //
    // One collection for every note a coach writes about a client, whatever
    // part of the app produced it. Replaces the hand-merge of focusRecords +
    // sessionNotes + clinicalIncidents in the Journal tab.
    //
    // Write posture matches the surrounding clinical collections: any
    // authenticated trainer may create and update. Two things are tightened:
    //
    //   1. An entry's author cannot be forged on create — authorId must be the
    //      caller's own uid. Journal entries are the record of who said what
    //      about a client, so authorship is the one field worth pinning.
    //   2. Hard delete is reserved for admins. Trainers archive instead
    //      (isArchived: true), so a note can never quietly vanish from a
    //      client's history.
    //
    // Narrow reads to isTrainerOfClient(clientId) in the pre-launch hardening
    // pass tracked in ROADMAP.md.
    // ================================================================
    match /journalEntries/{entryId} {
      allow read: if isAuthenticated();

      allow create: if isAuthenticated()
                    && isAnyAuthenticatedTrainer()
                    && request.resource.data.clientId is string
                    && request.resource.data.body is string
                    && request.resource.data.body.size() > 0
                    && request.resource.data.body.size() <= 5000
                    && request.resource.data.authorId == request.auth.uid;

      // authorId and clientId are immutable after creation.
      allow update: if isAuthenticated()
                    && isAnyAuthenticatedTrainer()
                    && request.resource.data.authorId == resource.data.authorId
                    && request.resource.data.clientId == resource.data.clientId
                    && request.resource.data.body.size() <= 5000;

      allow delete: if isSuperAdmin() || isFranchiseOwner();
    }

    // NOTE DISMISSALS — "no need to remind me", one document per trainer.
    //
    // Notes round, Sep 2026. A dismissal says what one trainer already knows
    // about one note thread. It is PRIVATE: nobody sees who dismissed what,
    // and there is nothing to gain by showing it. Rules apply to whole
    // documents, so privacy here means a document of its own, keyed by the
    // caller's own uid — which is also why the app must use the Auth uid and
    // not `authTrainer.id`, the two differing on older accounts.
    //
    // Nothing else reads this collection. A dismissal never changes the note
    // underneath it, so there is no role that needs to see another person's.
    match /noteDismissals/{uid} {
      allow read, write: if isAuthenticated() && request.auth.uid == uid;
    }

    // FORD — Family, Occupation, Recreation, Dreams.
    //
    // One document per personal detail, living at clients/{clientId}/ford/{id}.
    //
    // WHY IT IS NOT IN journalEntries: that collection is readable by every
    // signed-in user. A client's home life is not company-wide reading. Under
    // the client, a detail inherits the tightest boundary the app has — the
    // studio the client belongs to.
    //
    // WHY THE RECURSIVE WILDCARD: the Delight queue is a collectionGroup query
    // across every client's subcollection at one studio, and a collection group
    // read is only legal against a {path=**} match. It also covers direct reads
    // of a single client's details, so there is exactly one rule here to reason
    // about rather than two that can drift apart.
    //
    // The studio filter is load-bearing on read. Because the condition tests
    // resource.data.studioId, Firestore refuses any query that is not already
    // constrained to a studio the caller trains at — which is precisely the
    // guarantee we want, rather than one enforced only in app code.
    match /{path=**}/ford/{fordId} {
      allow read: if isAuthenticated()
                  && isAnyAuthenticatedTrainer()
                  && (
                       isSuperAdmin()
                       || isFranchiseOwner()
                       || isTrainerOfStudio(resource.data.studioId)
                     );

      // pillar is deliberately NOT validated as one of the four letters: null
      // is the floor path. A trainer mid-set types the sentence and saves, and
      // the category is chosen at teardown. Requiring it here would put a
      // decision between hearing the thing and recording it.
      allow create: if isAuthenticated()
                    && isAnyAuthenticatedTrainer()
                    && request.resource.data.clientId is string
                    && request.resource.data.body is string
                    && request.resource.data.body.size() > 0
                    && request.resource.data.body.size() <= 2000
                    && request.resource.data.authorId == request.auth.uid
                    && isTrainerOfStudio(request.resource.data.studioId);

      // clientId and studioId are immutable: a detail cannot be moved to
      // another client or walked out of its studio by an update.
      allow update: if isAuthenticated()
                    && isAnyAuthenticatedTrainer()
                    && request.resource.data.clientId == resource.data.clientId
                    && request.resource.data.studioId == resource.data.studioId
                    && request.resource.data.body.size() <= 2000
                    && (
                         isSuperAdmin()
                         || isFranchiseOwner()
                         || isTrainerOfStudio(resource.data.studioId)
                       );

      // Details are archived, not deleted — see ford-write.ts. The one
      // exception is a capture discarded before it was ever filed, which is
      // why the author keeps a delete on an untagged entry of their own.
      allow delete: if isSuperAdmin()
                    || isFranchiseOwner()
                    || (
                         isAnyAuthenticatedTrainer()
                         && resource.data.authorId == request.auth.uid
                         && resource.data.pillar == null
                       );
    }

    // TRAINER FOCUSES — a trainer's standing intent for a client.
    // Only the owning trainer (or a manager) may pass, extend or retire a
    // focus; anyone can read them, because every coach in the room needs to
    // know what their colleagues are working on with this client.
    match /clientFocuses/{focusId} {
      allow read: if isAuthenticated();

      allow create: if isAuthenticated()
                    && isAnyAuthenticatedTrainer()
                    && request.resource.data.clientId is string
                    && request.resource.data.trainerId == request.auth.uid
                    && request.resource.data.category in ['Posture', 'Path', 'Pace', 'Purpose'];

      allow update: if isAuthenticated()
                    && isAnyAuthenticatedTrainer()
                    && request.resource.data.trainerId == resource.data.trainerId
                    && (
                         resource.data.trainerId == request.auth.uid
                         || isSuperAdmin()
                         || isFranchiseOwner()
                         || isAdmin()
                       );

      allow delete: if isSuperAdmin() || isFranchiseOwner();
    }

    // STUDIOS: Territory configurations
    match /studios/{studioId} {
      allow read: if isAuthenticated();
      // My Studio round (Sep 2026) closes the hole CLAUDE.md carried as
      // "any trainer can edit any studios/{id} document": a studio is written
      // by administrators, franchise owners and ITS OWN leaders (head trainer,
      // studio leader, studio owner, or the grant) -- AJ, Sep 18. The one
      // thing every iPad still writes is the schedule sync's lease
      // (features/admin/useAutoSync: lastScheduleSyncAt, scheduleSyncFailures,
      // and since the lean sync of Sep 25 2026 lastDeepScheduleSyncAt, when
      // the last whole-month pull succeeded), so any trainer may touch those
      // three fields and nothing else.
      // Demo Mode (Sep 20 2026): `demo-studio` is laid down by the seeder from
      // inside the app, so anybody signed in may bring it into existence. The
      // id is a literal, so this creates exactly one studio and no other, and
      // update is already covered -- isStudioOwnerOrHeadTrainer is true there
      // for everyone.
      allow create: if isSuperAdmin() || isFranchiseOwner() || hasRunOfDemo(studioId);
      allow update: if isSuperAdmin() || isFranchiseOwner() || isStudioOwnerOrHeadTrainer(studioId) ||
                       (isAnyAuthenticatedTrainer() &&
                        request.resource.data.diff(resource.data).affectedKeys()
                          .hasOnly(['lastScheduleSyncAt', 'scheduleSyncFailures', 'lastDeepScheduleSyncAt']));
      allow delete: if isSuperAdmin();

      // RENEWAL SETTINGS (Renewals round, Sep 2026).
      //
      //   config/renewals      the studio's thresholds and package table.
      //                        Its leaders write it; everyone who works there
      //                        reads it (the trainer-side screens measure
      //                        against it).
      //   config/renewalsSeen  names the nightly job met in this studio's
      //                        Mindbody. Written by the job through the Admin
      //                        SDK, which these rules do not govern; nobody
      //                        writes it from the app.
      //
      // Reads are scoped to the studio, unlike roster/machineNotes: prices are
      // commercial, and this round's rule is that new collections do not copy
      // the open-read posture.
      match /config/{configId} {
        allow read: if isAuthenticated()
                    && renewalsReadable(studioId, getRole(), callerTrainer());
        allow create, update: if isAuthenticated()
                    && configId == 'renewals'
                    && renewalsManageable(studioId, getRole(), callerTrainer())
                    && renewalSettingsValid(request.resource.data);
        allow delete: if false;
      }

      // RENEWAL CYCLES AND CONVERSATIONS (Renewals round, Sep 2026).
      //
      //   renewals/{cycleKey}            one package term: the latest
      //                                  conversation, and the leaders'
      //                                  stage / lead / outcome
      //   renewals/{cycleKey}/touches    one document per conversation
      //
      // Everyone who works at the studio reads them and may log a
      // conversation; a trainer's write can touch only the conversation
      // fields (renewalTrainerKeys). Stage, lead and outcome are for the
      // studio's leaders. Per-trainer renewal RATES are computed from these in
      // the Operations dashboard, which only leaders can open (AJ, Sep 10).
      //
      // A conversation is never edited — an accountability log that can be
      // rewritten is not one — but a leader can delete a mistake. Cycles are
      // history and are never deleted. The nightly job writes outcomes
      // through the Admin SDK, which these rules do not govern.
      match /renewals/{cycleKey} {
        allow read: if isAuthenticated()
                    && renewalsReadable(studioId, getRole(), callerTrainer());
        allow create, update: if isAuthenticated() && (
          (renewalsManageable(studioId, getRole(), callerTrainer()) && renewalLeaderWrite()) ||
          (renewalsReadable(studioId, getRole(), callerTrainer()) && renewalTrainerWrite())
        );
        allow delete: if false;

        match /touches/{touchId} {
          allow read: if isAuthenticated()
                      && renewalsReadable(studioId, getRole(), callerTrainer());
          allow create: if isAuthenticated()
                        && renewalsReadable(studioId, getRole(), callerTrainer())
                        && renewalTouchValid(request.resource.data);
          allow update: if false;
          allow delete: if isAuthenticated()
                        && renewalsManageable(studioId, getRole(), callerTrainer());
        }
      }

      // STUDIO MACHINE ROSTER — what THIS location actually has
      // (round: Machine Creator & Studio Roster, Sep 2026).
      //
      // Tenancy is enforced by the path itself, so no get() lookup is spent
      // on it — which matters at 100+ studios, where every get() in a rule
      // counts against the per-request document budget.
      //
      // Writes: studio owners / leaders OF THIS STUDIO, or admins and above.
      // isStudioOwnerOrHeadTrainer() already accepts StudioOwner, HeadTrainer
      // and StudioLeader scoped by primaryHomeStudioId or ownedStudioIds.
      // A trainer at studio A cannot touch studio B's roster.
      //
      // Reads stay open to any authenticated trainer, matching the posture of
      // the surrounding collections and the multi-studio trainer case; narrow
      // to isTrainerOfStudio(studioId) in the pre-launch hardening pass
      // tracked in ROADMAP.md.
      match /roster/{machineId} {
        allow read: if isAuthenticated();
        allow create, update:
          if (isSuperAdmin() || isStudioOwnerOrHeadTrainer(studioId))
             && rosterWriteValid(studioId);
        allow delete:
          if isSuperAdmin() || isStudioOwnerOrHeadTrainer(studioId);
      }

      // STUDIO MACHINE NOTES — the floor's own notes about its equipment
      // (round: Catalog Redesign, Sep 2026).
      //
      // Separate from roster/{machineId} on purpose. A roster entry carries
      // `overrides`, which can rewrite clinicalWarnings, contraindicatedFor
      // and settingFields — so it is deliberately manager-write only. These
      // notes carry no safety content and no override power ("the left thigh
      // pad sticks", "use the footstool on this one"), and the trainer on the
      // floor is exactly who should be writing them.
      //
      // Tenancy is enforced by the path, same as the roster, so no get() is
      // spent on the check. A trainer at studio A cannot write studio B.
      match /machineNotes/{machineId} {
        allow read: if isAuthenticated();
        allow create, update: if isAuthenticated() && isAnyAuthenticatedTrainer()
                              && writesForStudio(studioId);
        allow delete: if isSuperAdmin() || isStudioOwnerOrHeadTrainer(studioId);
      }

      // EQUIPMENT UPKEEP LOG — "I deep-cleaned the leg press just now"
      // (round: Admin Overhaul, Sep 2026).
      //
      // Cleaning and servicing that was SCHEDULED already lands in
      // taskInstances. This is for the work that was not: a spilled shake, an
      // engineer replacing a seat pad on a Tuesday. Both feed one merged
      // timeline — see features/admin/upkeep/upkeepLog.ts.
      //
      // Any trainer may write, for the same reason as machineNotes: the
      // person who cleans the machine is the person on the floor, and an
      // upkeep entry carries no override power over safety content. Tenancy
      // comes from the path, so no get() is spent checking it.
      //
      // Entries are not editable after the fact — an accountability log that
      // can be rewritten is not one — but a manager can delete a mistake.
      /*
       * THE VAULT (Relay, Sep 2026) -- leadership notes: incidents and
       * partners. Its own collection because rules apply to whole
       * documents: nothing the floor may read sits beside these. Read and
       * written by the studio's leaders, franchise owners and administrators.
       */
      match /vault/{entryId} {
        allow read, create, update, delete:
          if isSuperAdmin() || isFranchiseOwnerOnly() || isStudioOwnerOrHeadTrainer(studioId);
      }

      /*
       * MACHINE FIT (Sep 2026) -- one document per machine: which of this
       * studio's clients is set to what (rows keyed by client id). It is the
       * index behind set-up suggestions and the set-up check; the client's
       * own clientMachineSettings stay the record, and
       * scripts/rebuild-machine-fit.ts can rebuild this from them.
       *
       * Read: the people who work at the studio -- the same people who can
       * already open these clients. NOT every signed-in trainer: a row is a
       * client id beside her settings.
       * Write: the same people, ONE ROW PER WRITE. The app only ever touches
       * the row of the client whose settings it just saved, and holding it to
       * that means a bad client cannot rewrite a studio's evidence in one go.
       * It holds no body data (no height, nothing from InBody): rows are
       * joined to the client record when they are read.
       */
      match /machineFit/{machineId} {
        allow read: if isAuthenticated() && writesForStudio(studioId);

        allow create: if isAuthenticated()
                      && isAnyAuthenticatedTrainer()
                      && machineFitValid(request.resource.data, studioId, machineId)
                      && request.resource.data.get('rows', {}).size() <= 1
                      && writesForStudio(studioId);

        allow update: if isAuthenticated()
                      && isAnyAuthenticatedTrainer()
                      && machineFitValid(request.resource.data, studioId, machineId)
                      && request.resource.data.get('rows', {}).diff(resource.data.get('rows', {})).affectedKeys().size() <= 1
                      && writesForStudio(studioId);

        allow delete: if isSuperAdmin();
      }

      /*
       * THE WATCH (Operations round, Sep 2026) -- what the weekly job noticed
       * for this studio's Monday page: watch/performance is the clients whose
       * reps fell at the same weight (client id, machine id, the numbers, the
       * day -- no name, no body data; features/admin/monday/performance.ts).
       * Written only by the job (Admin SDK); read by the studio's people, as
       * the machineFit index is. Nothing in the app writes here.
       */
      match /watch/{watchId} {
        allow read: if isAuthenticated() && writesForStudio(studioId);
        allow write: if false;
      }

      /*
       * THE WATCHLIST (Operations overhaul, Sep 2026) -- one document per
       * client, keyed by client id: a leader's disposition of an attendance
       * anomaly. Snooze ("remind me again on this date") or dismiss ("I know
       * why they are out"). AJ, Sep 19: leaders clear people off the list.
       * Read by the studio's people; written by whoever runs the studio, a
       * franchise owner or an administrator. Deleting it puts the client
       * back on normal watch -- that is what "Got it" on a back-again row
       * does. features/admin/attention.
       */
      match /watchlist/{clientId} {
        allow read: if isAuthenticated() && writesForStudio(studioId);
        allow create, update, delete: if isSuperAdmin() || isFranchiseOwner()
                                      || isStudioOwnerOrHeadTrainer(studioId);
      }

      /*
       * ACKNOWLEDGEMENTS (Operations overhaul, Sep 2026) -- one document per
       * thing acknowledged on the Overview (an incident, a critical note, a
       * pain report on the Dial), keyed by its source. Who saw it, and when
       * -- beside the studio rather than on the trainer's note, so
       * acknowledging never rewrites what was written. Anyone who works here
       * may acknowledge (AJ: pain is visible to anyone who can open the
       * Overview, not leadership only), and only as themselves. Nothing is
       * ever deleted.
       */
      match /acknowledgements/{ackId} {
        allow read: if isAuthenticated() && writesForStudio(studioId);
        allow create, update: if isAuthenticated() && isAnyAuthenticatedTrainer()
                              && writesForStudio(studioId)
                              && request.resource.data.acknowledgedBy == request.auth.uid;
        allow delete: if false;
      }

      /*
       * MACHINE CARE (Relay, Sep 2026) -- one document per machine: when it
       * was last wiped and deep cleaned, by whom, and a flag. Written from
       * the Floor Map's care sheet by anyone who works at the studio; a wipe
       * is also appended to upkeepLog below, which Operations reads. A flag
       * is a note to the floor, never a roster status change.
       */
      match /machineCare/{machineId} {
        allow read: if isAuthenticated();

        allow create, update: if isAuthenticated()
                              && isAnyAuthenticatedTrainer()
                              && writesForStudio(studioId)
                              && machineCareValid(request.resource.data, machineId);

        allow delete: if isSuperAdmin() || isStudioOwnerOrHeadTrainer(studioId);
      }

      match /upkeepLog/{entryId} {
        allow read: if isAuthenticated();
        allow create: if isAuthenticated() && isAnyAuthenticatedTrainer()
                      && writesForStudio(studioId);
        allow update: if false;
        allow delete: if isSuperAdmin() || isStudioOwnerOrHeadTrainer(studioId);
      }

      // STUDIO TASKS — cleaning, maintenance and floor operations
      // (round: Studio To-Do, Sep 2026).
      //
      // Split by AUTHORITY, the same way machineNotes is split from roster.
      //
      // taskTemplates say what should happen and how often. That is a
      // management decision — it sets the standard the floor is held to — so
      // only studio leaders and above may write them.
      //
      // taskInstances are one day's occurrences. Checking one off is the whole
      // job of a trainer on the floor, so any authenticated trainer may create
      // and update them. Create is open because materialization is CLIENT-SIDE:
      // the first trainer to open the list writes the day. The ids are derived
      // deterministically from (template, date, shift, machine), so this cannot
      // be used to invent unbounded documents that the day's plan would render.
      //
      // Deleting history stays with management. A trainer who ticked the wrong
      // box re-opens it, which keeps the audit trail rather than erasing it.
      match /taskTemplates/{templateId} {
        allow read: if isAuthenticated();
        allow create, update, delete:
          if isSuperAdmin() || isStudioOwnerOrHeadTrainer(studioId);
      }

      /*
       * TASK INSTANCES — one day's occurrences.
       *
       * Checking one off is the whole job of a trainer on the floor, so any
       * authenticated trainer may create and update them. Create is open
       * because materialization is CLIENT-SIDE and the ids are derived
       * deterministically from (template, date, shift, machine), so this
       * cannot be used to invent unbounded documents.
       *
       * THE ASSIGNMENT FIELDS ARE THE EXCEPTION (round: Task assignment,
       * Sep 2026). Putting someone else's name on work is a head trainer's
       * act; closing the work is not. So `assignedTo` / `assignedBy` /
       * `assignedAt` are gated to studio leaders and head trainers while
       * every other field of the same document stays open to the floor.
       *
       * ORDERED CHEAPEST-FIRST, and here it genuinely matters: a studio does
       * 30-40 completions a day and perhaps one assignment. `affectedKeys()`
       * is field math and costs nothing; isStudioOwnerOrHeadTrainer() resolves
       * the caller through document reads. Written this way, the expensive
       * branch never evaluates on an ordinary tick. Getting this backwards is
       * what blew the 1000-expression budget on the sessions rule in Sep 2026.
       *
       * NOT A LOCK, and the rule cannot make it one: an assigned task is still
       * completable by anyone, because `status` is untouched by this gate.
       * That is deliberate — a trainer assigned the bins who gets pulled into
       * a consultation must not leave the bin full because the app said it was
       * handled.
       *
       * Deleting history stays with management. A trainer who ticked the wrong
       * box re-opens it, which keeps the audit trail rather than erasing it.
       */
      match /taskInstances/{instanceId} {
        allow read: if isAuthenticated();

        allow create: if isAuthenticated()
                      && isAnyAuthenticatedTrainer()
                      && (
                           !('assignedTo' in request.resource.data)
                        || request.resource.data.assignedTo == null
                        || isSuperAdmin()
                        || isStudioOwnerOrHeadTrainer(studioId)
                      );

        allow update: if isAuthenticated()
                      && isAnyAuthenticatedTrainer()
                      && (
                           !request.resource.data.diff(resource.data)
                              .affectedKeys()
                              .hasAny(['assignedTo', 'assignedBy', 'assignedAt'])
                        || isSuperAdmin()
                        || isStudioOwnerOrHeadTrainer(studioId)
                      );

        allow delete: if isSuperAdmin() || isStudioOwnerOrHeadTrainer(studioId);
      }

      // FLOATING REQUESTS — ad-hoc asks and low-priority studio comms
      // (round: Settings tiers & Task Board, Sep 2026).
      //
      // A separate collection from tasks because it has a different
      // lifecycle: a checklist resets nightly, a shift-cover ask never does.
      // See src/features/studio-tasks/requests.ts.
      //
      // Any trainer may post one and any trainer may claim, reply to or
      // resolve one — that IS the feature. The one thing pinned down is
      // authorship: createdBy.id must be the caller, so a request cannot be
      // posted in a colleague's name, and createdBy cannot be rewritten
      // afterwards to reassign an awkward one.
      //
      // Delete stays with management and the author. resolveRequest is the
      // normal path and keeps the thread; deleting is for a post made in
      // error, and Firestore does not cascade to the replies subcollection.
      /*
       * THE PLAYBOOK — the studio's accumulated coaching knowledge.
       *
       * PATTERN-ONLY, ENFORCED HERE AND NOT JUST IN THE TYPE.
       * `!('clientId' in request.resource.data)` is the load-bearing line. A
       * playbook entry describes a physical complaint and a workaround, it is
       * readable by every trainer at the studio, and it is built to LAST.
       * Attach a name to that and you have a searchable health record about
       * identifiable clients that anyone on the floor can browse -- a
       * different thing from a session note, which is attached to care being
       * delivered and read by the person delivering it.
       *
       * Putting the guard in the rule rather than only in TypeScript means a
       * future well-meaning change cannot quietly reintroduce client links:
       * the write would simply be refused. Same reasoning as the personal-task
       * path split -- structural, not remembered.
       *
       * WRITES: the author edits their own; anyone may confirm. The
       * confirmation branch uses affectedKeys().hasOnly(...) so a trainer
       * saying "worked for me too" cannot also rewrite the answer. Ordered
       * cheapest-first -- the two field checks cost nothing, and the
       * expensive leader check only runs if both fail.
       *
       * DELETE is manager-only, and the app retires instead: a resolved
       * request may point at an entry and the Catalog may be showing it
       * against a machine, so deleting orphans both.
       */
      match /playbook/{entryId} {
        // The studio's own people (review fix, Learning + Planner round).
        // Other studios read only what is shared, through the
        // {path=**}/playbook rule below; this read used to hand every
        // signed-in user every studio's unshared tips.
        allow read: if isAuthenticated() && writesForStudio(studioId);

        allow create: if isAuthenticated()
                      && isAnyAuthenticatedTrainer()
                      && request.resource.data.authorId == request.auth.uid
                      && request.resource.data.title is string
                      && request.resource.data.title.size() <= 120
                      && request.resource.data.worked is string
                      && !('clientId' in request.resource.data)
                      && sharedFieldsValid(request.resource.data)
                      && writesForStudio(studioId);

        allow update: if isAuthenticated()
                      && isAnyAuthenticatedTrainer()
                      && !('clientId' in request.resource.data)
                      && sharedFieldsValid(request.resource.data)
                      && (
                           resource.data.authorId == request.auth.uid
                        || request.resource.data.diff(resource.data)
                             .affectedKeys()
                             .hasOnly(['confirmations', 'lastConfirmedOn'])
                        || isStudioOwnerOrHeadTrainer(studioId)
                      )
                      && writesForStudio(studioId);

        allow delete: if isSuperAdmin() || isStudioOwnerOrHeadTrainer(studioId);
      }

      /*
       * THE STUDIO'S OWN WIKI CONTENT.
       * (round: Wiki Redesign Phase 4, Sep 2026 — see src/features/wiki/studio-wiki.ts)
       *
       * ONE COLLECTION, TWO AUTHORITIES, DISCRIMINATED BY `kind`.
       *
       *   kind == 'overlay'   a note ON something the app already ships: a
       *                       machine, an Academy topic, a quick card. ANY
       *                       trainer may write one. Same posture as
       *                       machineNotes and for the same reason -- an
       *                       overlay carries no override power over safety
       *                       content, and the person who discovers that the
       *                       left pad sticks is the person on the floor.
       *
       *   kind == 'page'      a whole page this studio authored. Studio
       *                       leaders and above, because a new page is a claim
       *                       about how the location operates.
       *
       * `kind` IS PINNED ON UPDATE. That single line is what stops an overlay
       * -- which anyone can write -- from being promoted into a page and
       * escaping the leader check. Without it the split above is decorative.
       *
       * ORDERED CHEAPEST-FIRST, deliberately. The `kind` comparison is a field
       * read and costs nothing; isStudioOwnerOrHeadTrainer() resolves the
       * caller through document reads. The overlay case is the common one and
       * short-circuits before the expensive branch ever evaluates. The sessions
       * rule blew Firestore's 1000-expression budget by getting this backwards
       * -- see the Sep 9 round.
       *
       * TENANCY comes from the path, same as roster and machineNotes, so no
       * get() is spent checking it. A trainer at studio A cannot write studio B.
       *
       * NO CLIENT IDS, enforced here and not only in TypeScript. This content
       * is readable by every trainer at the studio and is built to LAST;
       * attaching a client to it would quietly build a searchable health
       * record anyone on the floor can browse. Same argument as the playbook
       * above, same structural guard rather than a remembered convention.
       *
       * DELETE is manager-only. The app RETIRES instead: a machine article may
       * be linking to a page and the Academy index may be listing it, and
       * Firestore does not cascade.
       */
      match /wiki/{docId} {
        // As the playbook: the studio's own people; other studios read only
        // what is shared, through {path=**}/wiki below (review fix).
        allow read: if isAuthenticated() && writesForStudio(studioId);

        allow create: if isAuthenticated()
                      && isAnyAuthenticatedTrainer()
                      && request.resource.data.authorId == request.auth.uid
                      && request.resource.data.title is string
                      && request.resource.data.title.size() <= 160
                      && request.resource.data.kind in ['page', 'overlay']
                      && !('clientId' in request.resource.data)
                      && sharedFieldsValid(request.resource.data)
                      && (
                           request.resource.data.kind == 'overlay'
                        || isSuperAdmin()
                        || isStudioOwnerOrHeadTrainer(studioId)
                      )
                      && writesForStudio(studioId);

        allow update: if isAuthenticated()
                      && isAnyAuthenticatedTrainer()
                      && request.resource.data.title is string
                      && request.resource.data.title.size() <= 160
                      && request.resource.data.kind == resource.data.kind
                      && !('clientId' in request.resource.data)
                      && sharedFieldsValid(request.resource.data)
                      && (
                           resource.data.kind == 'overlay'
                        || isSuperAdmin()
                        || isStudioOwnerOrHeadTrainer(studioId)
                      )
                      && writesForStudio(studioId);

        allow delete: if isSuperAdmin() || isStudioOwnerOrHeadTrainer(studioId);
      }

      match /taskRequests/{requestId} {
        allow read: if isAuthenticated();

        allow create: if isAuthenticated()
                      && isAnyAuthenticatedTrainer()
                      && request.resource.data.createdBy.id == request.auth.uid
                      && request.resource.data.status == 'open'
                      && request.resource.data.title is string
                      && request.resource.data.title.size() <= 200;

        allow update: if isAuthenticated()
                      && isAnyAuthenticatedTrainer()
                      && request.resource.data.createdBy.id
                         == resource.data.createdBy.id;

        allow delete: if isSuperAdmin()
                      || isStudioOwnerOrHeadTrainer(studioId)
                      || resource.data.createdBy.id == request.auth.uid;

        // Replies are append-mostly: anyone may add one, only the author may
        // edit or remove their own, and management can clear anything.
        match /replies/{replyId} {
          allow read: if isAuthenticated();
          allow create: if isAuthenticated()
                        && isAnyAuthenticatedTrainer()
                        && request.resource.data.author.id == request.auth.uid
                        && request.resource.data.body is string
                        && request.resource.data.body.size() <= 2000;
          allow update, delete: if isSuperAdmin()
                                || isStudioOwnerOrHeadTrainer(studioId)
                                || resource.data.author.id == request.auth.uid;
        }

        /*
         * INITIATIVE SUBMISSIONS — what each trainer logged against a
         * manager's ask ("five progress reports each, by Friday").
         *
         * THE DOCUMENT ID IS THE TRAINER ID, and that is the whole
         * authorisation story: `request.auth.uid == trainerId` needs no
         * document read, no query constraint for a future caller to
         * remember, and no way for one trainer to overwrite another's.
         *
         * That last point is why this is a subcollection rather than an array
         * on the request. The Kaizen Roster is an array and is correct there
         * because a roster has ONE writer. An initiative has nine writers on
         * nine iPads at once, and whole-array writes would silently erase
         * each other.
         *
         * Reads stay open to the studio: the point of an initiative is that
         * everyone can see where the floor has got to.
         */
        match /submissions/{trainerId} {
          allow read: if isAuthenticated() && isAnyAuthenticatedTrainer();
          allow create, update: if isAuthenticated()
                                && request.auth.uid == trainerId
                                && request.resource.data.trainerId == trainerId;
          allow delete: if isSuperAdmin()
                        || isStudioOwnerOrHeadTrainer(studioId)
                        || request.auth.uid == trainerId;
        }
      }

      // A studio's own names for its work. Authoring these sets vocabulary
      // for the whole location, and a renamed category can change which
      // upkeep row a completed task feeds (see upkeepRoleOf in
      // features/studio-tasks/types.ts), so it is a management write.
      match /taskCategories/{categoryId} {
        allow read: if isAuthenticated();
        allow create, update, delete:
          if isSuperAdmin() || isStudioOwnerOrHeadTrainer(studioId);
      }

      // TEAM JOBS (Planner rework, Sep 2026) -- one piece of work several
      // people share: a deep clean, the birthday cards, calls to clients who
      // have gone quiet. See src/features/planner/jobs/types.ts.
      //
      // Read: the studio's own people (the path is the tenancy, checked on
      // read like comments). A client job carries client names.
      //
      // Posting and editing the job itself is a leader's act. The FLOOR may
      // touch exactly the fields that doing the work needs -- ticking parts
      // (one map key at a time), joining or leaving, closing and reopening --
      // and may not cancel a job or touch one a leader has called off. Nothing here locks the work to the people named
      // on it, on purpose: anyone at the studio can finish it.
      //
      // Ordered cheapest-first: affectedKeys() is field math; the leader
      // check resolves the caller through document reads.
      match /teamJobs/{jobId} {
        allow read: if isAuthenticated() && writesForStudio(studioId);

        allow create: if isAuthenticated()
                      && request.resource.data.createdBy.id == request.auth.uid
                      && request.resource.data.status == 'open'
                      && teamJobValid(request.resource.data, studioId)
                      && teamJobLeaderAllowed(studioId);

        allow update: if isAuthenticated()
                      && teamJobValid(request.resource.data, studioId)
                      && request.resource.data.createdBy == resource.data.createdBy
                      && (
                           (
                             request.resource.data.diff(resource.data).affectedKeys()
                               .hasOnly(['parts', 'assignees', 'assigneeIds', 'status', 'closedOn',
                                         'closingNote', 'completedBy', 'completedAt', 'updatedAt', 'kudos'])
                             && request.resource.data.status != 'cancelled'
                             && resource.data.status != 'cancelled'
                             && writesForStudio(studioId)
                           )
                        || teamJobLeaderAllowed(studioId)
                      );

        allow delete: if resource.data.createdBy.id == request.auth.uid
                      || teamJobLeaderAllowed(studioId);
      }

      // NOTES SHARED WITH COLLEAGUES (Planner rework, Sep 2026) -- a COPY of
      // a trainer's private note, for a handoff, a cover, or the whole team.
      // See src/features/planner/notes/team-share.ts.
      //
      // Read: the people it names (their uid is in audienceIds -- what the
      // app's `array-contains` query proves), or, for a team share, anyone
      // who works at the studio; and always its author.
      // Write: its author only, as themselves, at a studio they work at, the
      // whole document checked every time (the app overwrites it).
      // Delete: its author (even when already gone, so a batch never fails),
      // the studio's leaders, administrators.
      //
      // NOT ENFORCED HERE: `expiresOn`. A list query cannot be checked against
      // the clock; the app hides an expired copy and its author's Planner
      // deletes it. Ending a share by hand removes the copy immediately.
      match /noteShares/{noteId} {
        allow read: if isAuthenticated() && (
                      request.auth.uid in resource.data.audienceIds
                   || resource.data.authorId == request.auth.uid
                   || (resource.data.audience == 'team' && writesForStudio(studioId)));

        allow create: if isAuthenticated()
                      && noteShareValid(request.resource.data, studioId, noteId)
                      && writesForStudio(studioId);

        allow update: if isAuthenticated()
                      && resource.data.authorId == request.auth.uid
                      && noteShareValid(request.resource.data, studioId, noteId)
                      && writesForStudio(studioId);

        allow delete: if isAuthenticated() && (
                        resource == null
                     || resource.data.authorId == request.auth.uid
                     || isSuperAdmin()
                     || isStudioOwnerOrHeadTrainer(studioId));
      }

      // COMMENTS ON LEARNING PAGES (Learning + Planner round, Sep 2026).
      //
      // AJ chose "own studio": a studio's comments are read and written by
      // the people who work at (or run) it -- the path is the tenancy, and
      // unlike the older blocks above, this one checks it on READ as well.
      // Tagging someone rings their bell through the notifications rule; it
      // gives them nothing here they could not already read.
      //
      // The author may correct the words and the tags (signed with editedAt);
      // nothing else about a comment changes. The author, the studio's
      // leaders and administrators may take one down.
      match /comments/{commentId} {
        allow read: if isAuthenticated() && writesForStudio(studioId);

        allow create: if isAuthenticated() && isAnyAuthenticatedTrainer()
                      && writesForStudio(studioId)
                      && commentValid(request.resource.data, studioId)
                      && request.resource.data.authorId == request.auth.uid
                      && request.resource.data.createdAt == request.time
                      && !('editedAt' in request.resource.data);

        allow update: if isAuthenticated()
                      && resource.data.authorId == request.auth.uid
                      && writesForStudio(studioId)
                      && commentValid(request.resource.data, studioId)
                      && request.resource.data.diff(resource.data).affectedKeys()
                           .hasOnly(['body', 'mentions', 'editedAt'])
                      && request.resource.data.editedAt == request.time;

        allow delete: if isAuthenticated() && (
                        resource.data.authorId == request.auth.uid ||
                        isSuperAdmin() ||
                        isStudioOwnerOrHeadTrainer(studioId));
      }
    }

    // THE MSF MACHINE DATABASE (Learning + Planner round, Sep 2026).
    //
    // Collection-group reads over what studios chose to share: their own
    // machines (roster), their machine notes (wiki overlays) and their tips
    // (playbook). A collection-group query is judged by these rules alone,
    // and only one filtered on `shared == true` can pass -- so nothing a
    // studio did not share is listed to another. (A direct read of any of
    // these documents is still governed by the studios/{studioId} block,
    // which already lets any signed-in user read them.)
    //
    // Administrators may list rosters unfiltered: the catalog editor counts
    // the studios still running a machine before retiring it.
    match /{path=**}/roster/{machineId} {
      allow read: if isAuthenticated()
                  && (resource.data.shared == true || isSuperAdmin());
    }

    match /{path=**}/playbook/{entryId} {
      allow read: if isAuthenticated() && resource.data.shared == true;
    }

    match /{path=**}/wiki/{docId} {
      allow read: if isAuthenticated() && resource.data.shared == true;
    }

    // NETWORKS: Regional Franchise Groupings
    match /networks/{networkId} {
      allow read: if isAuthenticated();
      allow create, update: if isSuperAdmin() || isFranchiseOwner();
      allow delete: if isSuperAdmin();
    }

    match /aggregations/{aggId} {
      allow read: if isAuthenticated();
      allow write: if isSuperAdmin();
    }

    match /clinicalIncidents/{incidentId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated() && isAnyAuthenticatedTrainer();
    }

    // ACCESS REQUESTS
    match /access_requests/{requestId} {
      allow read: if isAuthenticated();
      allow create: if (
                      // Type 1: Initial System Access
                      (
                        hasRequiredFields(['email', 'fullName']) &&
                        request.resource.data.email is string && request.resource.data.email.size() < 100 &&
                        request.resource.data.fullName is string && request.resource.data.fullName.size() < 100 &&
                        (!('phone' in request.resource.data) || (request.resource.data.phone is string && request.resource.data.phone.size() < 50)) &&
                        (!('reason' in request.resource.data) || (request.resource.data.reason is string && request.resource.data.reason.size() < 1000)) &&
                        request.resource.data.status == 'Pending'
                      ) ||
                      // Type 2: Studio Access
                      (
                        isAuthenticated() &&
                        request.resource.data.type == 'studio_access' &&
                        request.resource.data.trainerId == request.auth.uid &&
                        request.resource.data.status == 'Pending'
                      )
                    );
      // A studio's leaders let people in from My Studio -> Team (My Studio
      // round, Sep 2026): marking the request Approved is theirs too.
      allow update, delete: if isSuperAdmin() || isFranchiseOwner() ||
                            (isAuthenticated() && leadsAnyStudio(getRole(), callerTrainer())) ||
                            (isAuthenticated() && request.resource.data.type == 'studio_access' && request.resource.data.trainerId == request.auth.uid);
    }

    // BUG REPORTS
    //
    // The read rule was superadmin-only, and features/feedback/useMyFeedback
    // queries this collection filtered to `userId == me` so a trainer can see
    // what became of their reports - its own header says it exists "for when
    // reports feel like they go nowhere". That listener was denied for every
    // trainer but the owner, silently, so the reports went nowhere visibly
    // too. A reporter may read their OWN report; nobody else can.
    match /bug_reports/{reportId} {
      allow read: if isSuperAdmin()
                  || (isAuthenticated() && resource.data.userId == request.auth.uid);
      allow create: if isAuthenticated();
      allow update, delete: if isSuperAdmin();
    }

    // ANNOUNCEMENTS
    //
    // Learning + Planner round, Sep 2026: posting and editing were open to
    // any signed-in user with the right field names -- anyone could post to
    // every studio, or rewrite someone else's notice. Now they follow the
    // app: only the people it offers the composer to (canPostAnnouncements)
    // post or change a notice. Everyone else may do the one thing the bell
    // does: add THEMSELVES, by sign-in id, to readBy, and nothing more.
    match /hub_announcements/{announcementId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && hubAnnouncementCreateAllowed();
      allow update: if isAuthenticated() && hubAnnouncementUpdateAllowed();
      allow delete: if isSuperAdmin() || isFranchiseOwner() || 
                    (resource.data.studioId != null && isStudioOwnerOrHeadTrainer(resource.data.studioId));
    }

    // CATALOG SUBMISSIONS (My Studio round, Sep 2026). A studio's leaders
    // offer one of the studio's OWN machines to corporate for the MSF
    // catalog (My Studio -> Machines -> Offer to the MSF catalog). Corporate
    // decides -- administrators only -- and publishing is an id migration
    // run from the PC (scripts/migrate-machine-id.ts), never a tap here.
    // The submitting studio reads its own; the roster entry carries a copy
    // of the status so the floor can show it.
    match /catalogSubmissions/{submissionId} {
      allow read: if isSuperAdmin()
                  || (isAuthenticated() && resource.data.get('studioId', '') != ''
                      && trainerLeads(getRole(), callerTrainer(), resource.data.studioId));
      allow create: if isAuthenticated()
                    && catalogSubmissionValid(request.resource.data)
                    && request.resource.data.status == 'pending'
                    && request.resource.data.submittedBy == request.auth.uid
                    && trainerLeads(getRole(), callerTrainer(), request.resource.data.studioId);
      // Corporate decides; the studio may only withdraw a pending offer.
      allow update: if isSuperAdmin()
                    || (isAuthenticated()
                        && resource.data.status == 'pending'
                        && request.resource.data.status == 'withdrawn'
                        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'updatedAt'])
                        && trainerLeads(getRole(), callerTrainer(), resource.data.studioId));
      allow delete: if isSuperAdmin();
    }

    // NOTIFICATION QUEUE (for email/SMS triggers)
    match /notificationQueue/{notifId} {
      allow read: if isSuperAdmin() || isFranchiseOwner();
      allow create: if isAuthenticated();
      allow update, delete: if isSuperAdmin();
    }

    // ===============================================================
    // MINDBODY INTEGRATION
    // ===============================================================

    // Permanent cross-train access record
    match /clients/{clientId}/crossTrainAccess/{studioId} {
      allow read: if isAuthenticated();
      allow create, update: if isSuperAdmin() || (
        isStudioOwnerOrHeadTrainer(studioId) &&
        request.resource.data.grantedBy == request.auth.uid &&
        request.resource.data.keys().hasAll(['granted', 'grantedAt', 'grantedBy']) &&
        request.resource.data.granted == true
      );
      allow delete: if isAdmin() || isFounder();
    }

    // Cross-train request submissions
    match /crossTrainRequests/{requestId} {
      allow create: if isAuthenticated() &&
        request.resource.data.requestingTrainerId == request.auth.uid &&
        request.resource.data.status == 'pending';
      allow read: if isAuthenticated();
      allow update: if isSuperAdmin() || isStudioOwnerOrHeadTrainer(resource.data.targetStudioId);
      allow delete: if isSuperAdmin();
    }

    // Webhook idempotency log (server-only writes; admins can read)
    match /mindbodyEventLog/{messageId} {
      allow read: if isSuperAdmin();
      allow write: if false;
    }

    // Dead letter queue (server writes; admins read and resolve)
    match /mindbodyDLQ/{messageId} {
      allow read: if isSuperAdmin();
      allow update: if isSuperAdmin();
      allow create, delete: if false;
    }

    // Limbo queue: bookings/clients the webhook or pull-sync could not file
    // against a studio. The webhook's writes come from the Admin SDK (bypasses
    // rules entirely); the pull-sync's parkPullSyncBooking() runs client-side
    // and needs create access, and the Admin UI's release/resolve path needs
    // update access. No rule existed here before, so the global safety net
    // denied read AND write to every user regardless of role.
    match /mindbodyLimbo/{eventId} {
      allow read: if isSuperAdmin();
      allow create: if isAuthenticated();
      allow update: if isSuperAdmin();
      allow delete: if false;
    }

    // Global integration health (server writes; all authenticated users read for UI)
    match /system/health {
      allow read: if isAuthenticated();
      allow write: if false;
    }

  }
}
