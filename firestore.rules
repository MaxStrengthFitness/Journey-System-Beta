rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ===============================================================
    // GLOBAL SAFETY NET
    // ===============================================================
    match /{document=**} {
      allow read, write: if false;
    }

    // ===============================================================
    // RBAC & MULTI-TENANCY HELPERS
    // ===============================================================
    
    function isAuthenticated() {
      return request.auth != null;
    }

    function getTrainerData() {
      return get(/databases/$(database)/documents/trainers/$(request.auth.uid)).data;
    }

    function getRole() {
      return request.auth != null && exists(/databases/$(database)/documents/trainers/$(request.auth.uid))
        ? ('role' in getTrainerData() && getTrainerData().role != null ? getTrainerData().role : 'none')
        : 'none';
    }

    function isAdmin() {
      return isAuthenticated() && (
        request.auth.token.role == 'Admin' ||
        getRole() == 'Admin'
      );
    }

    function isFounder() {
      return isAuthenticated() && (
        request.auth.token.role == 'Founder' ||
        request.auth.token.role == 'Overseer' ||
        getRole() == 'Founder' || 
        getRole() == 'Overseer'
      );
    }

    // 1. SUPER ADMIN: Absolute master access to everything
    function isSuperAdmin() {
      return isAdmin() || isFounder() || (
        isAuthenticated() &&
        (request.auth.token.email == 'jurgensaj@gmail.com' || request.auth.uid == 'k585kU0uOGWnoVVJjdRUBWgEiph2')
      );
    }

    // 2. FRANCHISE OWNER: Management authority of regional studio systems
    function isFranchiseOwner() {
      return isSuperAdmin() || (
        isAuthenticated() && (
          getRole() == 'FranchiseOwner' || 
          getRole() == 'Owner'
        )
      );
    }

    // 3. STUDIO OWNER & HEAD TRAINER: Read/write strictly bounded by location parameter
    function isStudioOwnerOrHeadTrainer(studioId) {
      return isFranchiseOwner() || (
        isAuthenticated() && (
          // Secure Custom Token Claim check
          (request.auth.token.studioId != null && request.auth.token.studioId == studioId) ||
          // Database Backed verification fallback
          (
            (getRole() == 'StudioOwner' || getRole() == 'HeadTrainer') &&
            (
              getTrainerData().primaryHomeStudioId == studioId || 
              ('ownedStudioIds' in getTrainerData() && getTrainerData().ownedStudioIds != null && getTrainerData().ownedStudioIds.hasAny([studioId]))
            )
          )
        )
      );
    }

    // 4. TRAINER: Limited strictly to designated home or accessible guest studios
    function isTrainerOfStudio(studioId) {
      return isStudioOwnerOrHeadTrainer(studioId) || (
        isAuthenticated() && (
          (getRole() == 'Trainer' || getRole() == 'LifeTransformer' || getRole() == 'StudioLeader') &&
          (
            getTrainerData().primaryHomeStudioId == studioId ||
            ('accessibleStudioIds' in getTrainerData() && getTrainerData().accessibleStudioIds != null && getTrainerData().accessibleStudioIds.hasAny([studioId])) ||
            ('activeGuestStudioIds' in getTrainerData() && getTrainerData().activeGuestStudioIds != null && getTrainerData().activeGuestStudioIds.hasAny([studioId]))
          )
        )
      );
    }

    // 5. HELPER: Resolve studio or homeStudioId field safely from a data map
    function getStudioIdFromData(data) {
      return data.get('homeStudioId', data.get('studioId', null));
    }

    function isTrainerOfStudioOrClient(studioId, clientId) {
      return isSuperAdmin() || isFranchiseOwner() || (
        isAuthenticated() && (
          (studioId != null && isTrainerOfStudio(studioId)) ||
          (clientId != null && exists(/databases/$(database)/documents/clients/$(clientId)) && (
            getStudioIdFromData(get(/databases/$(database)/documents/clients/$(clientId)).data) != null &&
            isTrainerOfStudio(getStudioIdFromData(get(/databases/$(database)/documents/clients/$(clientId)).data))
          ))
        )
      );
    }

    function hasRequiredFields(fields) {
      return request.resource.data.keys().hasAll(fields);
    }

    // ===============================================================
    // VALIDATORS & PROPERTY MATCHERS
    // ===============================================================

    function isValidTrainer(data) {
      return hasRequiredFields(['fullName', 'initials', 'primaryHomeStudioId']) &&
             data.fullName is string && data.fullName.size() > 0 && data.fullName.size() < 100 &&
             data.initials is string && data.initials.size() >= 2 && data.initials.size() <= 4 &&
             (!('pin' in data) || data.pin == null || (data.pin is string && (data.pin == '' || data.pin.matches('^[0-9a-fA-F]{4,64}$')))) &&
             data.primaryHomeStudioId is string && data.primaryHomeStudioId.size() > 0 && data.primaryHomeStudioId.size() < 100 &&
             (!('mindbody_ical_url' in data) || data.mindbody_ical_url == null || (data.mindbody_ical_url is string && data.mindbody_ical_url.size() < 500)) &&
             (!('role' in data) || data.role == null || data.role is string) &&
             (!('accessibleStudioIds' in data) || data.accessibleStudioIds == null || data.accessibleStudioIds is list) &&
             (!('activeGuestStudioIds' in data) || data.activeGuestStudioIds == null || data.activeGuestStudioIds is list) &&
             (!('createdAt' in data) || data.createdAt == null || data.createdAt is timestamp || data.createdAt is string);
    }

    function isValidClient(data) {
      return hasRequiredFields(['firstName', 'lastName', 'isActive', 'remainingSessions']) &&
             data.firstName is string && data.firstName.size() > 0 && data.firstName.size() < 50 &&
             data.lastName is string && data.lastName.size() > 0 && data.lastName.size() < 50 &&
             data.isActive is bool &&
             data.remainingSessions is number && data.remainingSessions >= 0;
    }

    function isValidMachine(data) {
      return hasRequiredFields(['name', 'order']) &&
             data.name is string && data.name.size() > 0 &&
             data.order is number;
    }

    function isValidSession(data) {
      return (!data.keys().hasAll(['sessionNumber']) || data.sessionNumber is number) &&
             (!data.keys().hasAll(['date']) || data.date is string) &&
             (!data.keys().hasAll(['trainerInitials']) || data.trainerInitials is string);
    }

    // Since updates can be partial list updates, we enforce type-safety for incoming fields
    function isValidLog(data) {
      return hasRequiredFields(['sessionId', 'machineId']) &&
             data.sessionId is string &&
             data.machineId is string;
    }

    function isValidSchedule(data) {
      return hasRequiredFields(['clientName', 'trainerName', 'startTime', 'endTime', 'status', 'serviceName', 'source']);
    }

    function isValidNetwork(data) {
      return hasRequiredFields(['name', 'ownerId', 'studioIds']) &&
             data.name is string && data.name.size() > 0 && data.name.size() < 100 &&
             data.ownerId is string &&
             data.studioIds is list;
    }

    function isValidHubAnnouncement(data) {
      return hasRequiredFields(['title', 'shortContent', 'longContent', 'authorId', 'authorName', 'studioId', 'isActive', 'priority']);
    }

    // ===============================================================
    // COLLECTION ENDPOINTS SECURITY PATHS
    // ===============================================================

    // TRAINERS: Directory search, auth checks, and creation permissions
    match /trainers/{trainerId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && 
                    request.resource.data.primaryHomeStudioId != null &&
                    isValidTrainer(request.resource.data) &&
                    (isSuperAdmin() || isFranchiseOwner() || 
                     isStudioOwnerOrHeadTrainer(request.resource.data.primaryHomeStudioId));
      allow update: if isSuperAdmin() || 
                    ( (isFranchiseOwner() || 
                      (resource.data.primaryHomeStudioId != null && isStudioOwnerOrHeadTrainer(resource.data.primaryHomeStudioId)) || 
                      (isAuthenticated() && request.auth.uid == trainerId))
                      && 
                      (!('role' in request.resource.data) || 
                       request.resource.data.role == resource.data.role || 
                       (request.resource.data.role != 'Founder' && request.resource.data.role != 'Admin' && request.resource.data.role != 'Overseer'))
                    ) ||
                    (
                      isAuthenticated() &&
                      request.auth.uid == trainerId &&
                      resource.data.requiresPinReset == true &&
                      request.resource.data.requiresPinReset == false &&
                      request.resource.data.diff(resource.data).affectedKeys().hasOnly(['requiresPinReset', 'updatedAt'])
                    ) ||
                    ( // Ensure pin/pinHash updates fail unless they are empty (for backfill/migration compatibility)
                      isAuthenticated() && request.resource.data.diff(resource.data).affectedKeys().hasAny(['pin', 'pinHash']) &&
                      (!('pin' in request.resource.data) || request.resource.data.pin == '') &&
                      (!('pinHash' in request.resource.data) || request.resource.data.pinHash == '')
                    );
      allow delete: if isSuperAdmin();

      match /secrets/account {
        allow read: if isSuperAdmin() || request.auth.uid == trainerId || 
            (exists(/databases/$(database)/documents/trainers/$(trainerId)) && 
             isStudioOwnerOrHeadTrainer(get(/databases/$(database)/documents/trainers/$(trainerId)).data.primaryHomeStudioId));
        allow write: if isSuperAdmin() || request.auth.uid == trainerId || 
            (exists(/databases/$(database)/documents/trainers/$(trainerId)) && 
             isStudioOwnerOrHeadTrainer(get(/databases/$(database)/documents/trainers/$(trainerId)).data.primaryHomeStudioId));
      }

      match /machineRoster/{machineId} {
        allow read: if isTrainerOfStudio(studioId);
        allow write: if isStudioOwnerOrHeadTrainer(studioId);
      }
  
    }

    // CLIENTS: Securely allows general directory access to authenticated systems / staff
    match /clients/{clientId} {
      allow read: if isAuthenticated() && (isSuperAdmin() || isFranchiseOwner() || (getStudioIdFromData(resource.data) != null && isTrainerOfStudio(getStudioIdFromData(resource.data))));
      allow create: if isAuthenticated() && 
                    isValidClient(request.resource.data) && 
                    (isSuperAdmin() || (getStudioIdFromData(request.resource.data) != null && isTrainerOfStudio(getStudioIdFromData(request.resource.data))));
      allow update: if isAuthenticated() && 
                    isValidClient(request.resource.data) && 
                    (isSuperAdmin() || (getStudioIdFromData(resource.data) != null && isTrainerOfStudio(getStudioIdFromData(resource.data))));
      allow delete: if isSuperAdmin();
    }

    // DISK SETTINGS: Machine settings assigned to specific athletes
    match /clientMachineSettings/{settingId} {
      allow read: if isAuthenticated() && isTrainerOfStudioOrClient(getStudioIdFromData(resource.data), resource.data.get('clientId', null));
      allow create: if isAuthenticated() && isTrainerOfStudioOrClient(getStudioIdFromData(request.resource.data), request.resource.data.get('clientId', null));
      allow update: if isAuthenticated() && isTrainerOfStudioOrClient(getStudioIdFromData(request.resource.data), request.resource.data.get('clientId', null)) && (resource == null || getStudioIdFromData(resource.data) == getStudioIdFromData(request.resource.data));
      allow delete: if isSuperAdmin() || isFranchiseOwner() || isAuthenticated();
    }

    // PHYSICAL MACHINES
    match /machines/{machineId} {
      allow read: if isAuthenticated();
      allow create, update: if isSuperAdmin() || isFranchiseOwner();
      allow delete: if isSuperAdmin();

      match /settingHistory/{historyId} {
        allow read, write: if isAuthenticated();
      }
    }

    match /machineSettingChanges/{changeId} {
      allow read: if isAuthenticated() && isTrainerOfStudioOrClient(getStudioIdFromData(resource.data), resource.data.get('clientId', null));
      allow create: if isAuthenticated() && isTrainerOfStudioOrClient(getStudioIdFromData(request.resource.data), request.resource.data.get('clientId', null));
    }

    // ROUTINES & ADJUSTMENTS
    match /routines/{routineId} {
      allow read: if isAuthenticated() && isTrainerOfStudioOrClient(getStudioIdFromData(resource.data), resource.data.get('clientId', null));
      allow create: if isAuthenticated() && isTrainerOfStudioOrClient(getStudioIdFromData(request.resource.data), request.resource.data.get('clientId', null));
      allow update: if isAuthenticated() && isTrainerOfStudioOrClient(getStudioIdFromData(request.resource.data), request.resource.data.get('clientId', null)) && (resource == null || getStudioIdFromData(resource.data) == getStudioIdFromData(request.resource.data));
      allow delete: if isSuperAdmin() || isFranchiseOwner();
    }

    match /routineAdjustments/{adjustmentId} {
      allow read: if isAuthenticated() && isTrainerOfStudioOrClient(getStudioIdFromData(resource.data), resource.data.get('clientId', null));
      allow create: if isAuthenticated() && isTrainerOfStudioOrClient(getStudioIdFromData(request.resource.data), request.resource.data.get('clientId', null));
    }

    // TRAINING SESSIONS
    match /sessions/{sessionId} {
      allow read: if isAuthenticated() && (
        isSuperAdmin() || isFranchiseOwner() ||
        (resource.data.get('hostedAtStudioId', null) != null && isTrainerOfStudio(resource.data.hostedAtStudioId))
      );
      allow create: if isAuthenticated() && 
                    request.resource.data.get('hostedAtStudioId', null) != null && 
                    isTrainerOfStudio(request.resource.data.hostedAtStudioId);
      allow update: if isAuthenticated() && 
                    request.resource.data.get('hostedAtStudioId', null) != null && 
                    isTrainerOfStudio(request.resource.data.hostedAtStudioId) && 
                    resource.data.get('hostedAtStudioId', null) == request.resource.data.get('hostedAtStudioId', null);
      allow delete: if isSuperAdmin() || isFranchiseOwner();

      match /logs/{logId} {
        allow read, write: if isAuthenticated() &&
          sessionId != null && exists(/databases/$(database)/documents/sessions/$(sessionId)) &&
          get(/databases/$(database)/documents/sessions/$(sessionId)).data.get('hostedAtStudioId', null) != null &&
          isTrainerOfStudio(get(/databases/$(database)/documents/sessions/$(sessionId)).data.hostedAtStudioId);
      }
    }

    // EXERCISE LOGS
    match /exerciseLogs/{logId} {
      allow read: if isAuthenticated() && (
        isSuperAdmin() || isFranchiseOwner() ||
        (resource.data.get('sessionId', null) != null && exists(/databases/$(database)/documents/sessions/$(resource.data.sessionId)) && get(/databases/$(database)/documents/sessions/$(resource.data.sessionId)).data.get('hostedAtStudioId', null) != null && isTrainerOfStudio(get(/databases/$(database)/documents/sessions/$(resource.data.sessionId)).data.hostedAtStudioId)) ||
        (resource.data.get('clientId', null) != null && exists(/databases/$(database)/documents/clients/$(resource.data.clientId)) && getStudioIdFromData(get(/databases/$(database)/documents/clients/$(resource.data.clientId)).data) != null && isTrainerOfStudio(getStudioIdFromData(get(/databases/$(database)/documents/clients/$(resource.data.clientId)).data)))
      );
      allow create: if isAuthenticated() && isValidLog(request.resource.data) && (
        isSuperAdmin() || isFranchiseOwner() ||
        (request.resource.data.get('sessionId', null) != null && exists(/databases/$(database)/documents/sessions/$(request.resource.data.sessionId)) && get(/databases/$(database)/documents/sessions/$(request.resource.data.sessionId)).data.get('hostedAtStudioId', null) != null && isTrainerOfStudio(get(/databases/$(database)/documents/sessions/$(request.resource.data.sessionId)).data.hostedAtStudioId)) ||
        (request.resource.data.get('clientId', null) != null && exists(/databases/$(database)/documents/clients/$(request.resource.data.clientId)) && getStudioIdFromData(get(/databases/$(database)/documents/clients/$(request.resource.data.clientId)).data) != null && isTrainerOfStudio(getStudioIdFromData(get(/databases/$(database)/documents/clients/$(request.resource.data.clientId)).data)))
      );
      allow update: if isAuthenticated() && isValidLog(request.resource.data) && (
        isSuperAdmin() || isFranchiseOwner() ||
        (request.resource.data.get('sessionId', null) != null && exists(/databases/$(database)/documents/sessions/$(request.resource.data.sessionId)) && get(/databases/$(database)/documents/sessions/$(request.resource.data.sessionId)).data.get('hostedAtStudioId', null) != null && isTrainerOfStudio(get(/databases/$(database)/documents/sessions/$(request.resource.data.sessionId)).data.hostedAtStudioId)) ||
        (request.resource.data.get('clientId', null) != null && exists(/databases/$(database)/documents/clients/$(request.resource.data.clientId)) && getStudioIdFromData(get(/databases/$(database)/documents/clients/$(request.resource.data.clientId)).data) != null && isTrainerOfStudio(getStudioIdFromData(get(/databases/$(database)/documents/clients/$(request.resource.data.clientId)).data)))
      ) && (
        resource.data.get('sessionId', null) == request.resource.data.get('sessionId', null) &&
        resource.data.get('clientId', null) == request.resource.data.get('clientId', null)
      );
      allow delete: if isSuperAdmin() || isFranchiseOwner();
    }

    // CALENDAR SCHEDULES
    match /schedules/{scheduleId} {
      allow read: if isAuthenticated() && (isSuperAdmin() || isFranchiseOwner() || (resource.data.studioId != null && isTrainerOfStudio(resource.data.studioId)));
      allow create, update: if (
        isFranchiseOwner() || 
        isSuperAdmin() ||
        (getStudioIdFromData(request.resource.data) != null && isTrainerOfStudio(getStudioIdFromData(request.resource.data)))
      ) && isValidSchedule(request.resource.data);
      allow delete: if isSuperAdmin() || isFranchiseOwner();
    }
    
    // CLINICAL NOTES
    match /sessionNotes/{noteId} {
      allow read: if isAuthenticated() && isTrainerOfStudioOrClient(getStudioIdFromData(resource.data), resource.data.get('clientId', null));
      allow create: if isAuthenticated() && isTrainerOfStudioOrClient(getStudioIdFromData(request.resource.data), request.resource.data.get('clientId', null));
      allow update: if isAuthenticated() && isTrainerOfStudioOrClient(getStudioIdFromData(request.resource.data), request.resource.data.get('clientId', null)) && (resource == null || getStudioIdFromData(resource.data) == getStudioIdFromData(request.resource.data));
      allow delete: if isSuperAdmin() || isFranchiseOwner();
    }

    match /users/{userId} {
      allow read, write: if isSuperAdmin() || request.auth.uid == userId;
    }

    
    // AUDIT LOGS
    match /auditLogs/{logId} {
      allow read: if isSuperAdmin() || isFranchiseOwner();
      allow create: if isAuthenticated();
      allow update, delete: if isSuperAdmin();
    }
  
    match /leaderboards/{docId} {
      allow read: if isAuthenticated();
      allow write: if isSuperAdmin();
    }

    // SPECIAL ATHLETE FOCUS PATTERNS
    match /trainerFocuses/{focusId} {
      allow read: if isAuthenticated() && isTrainerOfStudioOrClient(getStudioIdFromData(resource.data), resource.data.get('clientId', null));
      allow create: if isAuthenticated() && isTrainerOfStudioOrClient(getStudioIdFromData(request.resource.data), request.resource.data.get('clientId', null));
      allow update: if isAuthenticated() && isTrainerOfStudioOrClient(getStudioIdFromData(request.resource.data), request.resource.data.get('clientId', null)) && (resource == null || getStudioIdFromData(resource.data) == getStudioIdFromData(request.resource.data));
      allow delete: if isSuperAdmin() || isFranchiseOwner();
    }

    match /progressReports/{reportId} {
      allow read: if isAuthenticated() && isTrainerOfStudioOrClient(getStudioIdFromData(resource.data), resource.data.get('clientId', null));
      allow create: if isAuthenticated() && isTrainerOfStudioOrClient(getStudioIdFromData(request.resource.data), request.resource.data.get('clientId', null));
      allow update: if isAuthenticated() && isTrainerOfStudioOrClient(getStudioIdFromData(request.resource.data), request.resource.data.get('clientId', null)) && (resource == null || getStudioIdFromData(resource.data) == getStudioIdFromData(request.resource.data));
      allow delete: if isSuperAdmin() || isFranchiseOwner();
    }

    match /focusRecords/{focusId} {
      allow read: if isAuthenticated() && isTrainerOfStudioOrClient(getStudioIdFromData(resource.data), resource.data.get('clientId', null));
      allow create: if isAuthenticated() && isTrainerOfStudioOrClient(getStudioIdFromData(request.resource.data), request.resource.data.get('clientId', null));
      allow update: if isAuthenticated() && isTrainerOfStudioOrClient(getStudioIdFromData(request.resource.data), request.resource.data.get('clientId', null)) && (resource == null || getStudioIdFromData(resource.data) == getStudioIdFromData(request.resource.data));
      allow delete: if isSuperAdmin() || isFranchiseOwner();
    }

    // STUDIOS: Territory configurations
    match /studios/{studioId} {
      allow read: if isAuthenticated();
      allow create, update: if isSuperAdmin() || isFranchiseOwner() || isStudioOwnerOrHeadTrainer(studioId);
      allow delete: if isSuperAdmin();
    }

    // NETWORKS: Regional Franchise Groupings
    match /networks/{networkId} {
      allow read: if isAuthenticated();
      allow create, update: if isSuperAdmin() || isFranchiseOwner();
      allow delete: if isSuperAdmin();
    }

    match /aggregations/{aggId} {
      allow read: if isAuthenticated();
      allow write: if isSuperAdmin();
    }

    match /clinicalIncidents/{incidentId} {
      allow read: if isSuperAdmin() || (resource.data.studioId != null && isTrainerOfStudio(resource.data.studioId));
      allow write: if isSuperAdmin() || (request.resource.data.studioId != null && isTrainerOfStudio(request.resource.data.studioId));
    }

    // ACCESS REQUESTS
    match /access_requests/{requestId} {
      allow create: if hasRequiredFields(['email', 'fullName']) &&
                    request.resource.data.email is string && request.resource.data.email.size() < 100 &&
                    request.resource.data.fullName is string && request.resource.data.fullName.size() < 100 &&
                    (!('phone' in request.resource.data) || (request.resource.data.phone is string && request.resource.data.phone.size() < 50)) &&
                    (!('reason' in request.resource.data) || (request.resource.data.reason is string && request.resource.data.reason.size() < 1000)) &&
                    request.resource.data.status == 'Pending';
      allow read, update, delete: if isSuperAdmin();
    }

    // BUG REPORTS
    match /bug_reports/{reportId} {
      allow read: if isSuperAdmin();
      allow create: if isAuthenticated();
      allow update, delete: if isSuperAdmin();
    }

    // ANNOUNCEMENTS
    match /hub_announcements/{announcementId} {
      allow read: if isAuthenticated();
      allow create, update: if isAuthenticated() && isValidHubAnnouncement(request.resource.data);
      allow delete: if isSuperAdmin() || isFranchiseOwner() || 
                    (resource.data.studioId != null && isStudioOwnerOrHeadTrainer(resource.data.studioId));
    }

    // ===============================================================
    // MINDBODY INTEGRATION
    // ===============================================================

    // Permanent cross-train access record (per Section 11.3, Decision #2)
    // Path: clients/{clientId}/crossTrainAccess/{studioId}
    match /clients/{clientId}/crossTrainAccess/{studioId} {
      allow read: if isAuthenticated();
      allow create, update: if isSuperAdmin() || (
        isStudioOwnerOrHeadTrainer(studioId) &&
        request.resource.data.grantedBy == request.auth.uid &&
        request.resource.data.keys().hasAll(['granted', 'grantedAt', 'grantedBy']) &&
        request.resource.data.granted == true
      );
      allow delete: if isAdmin() || isFounder();
    }

    // Cross-train request submissions (per Section 4.4)
    // Path: crossTrainRequests/{requestId}
    match /crossTrainRequests/{requestId} {
      allow create: if isAuthenticated() &&
        request.resource.data.requestingTrainerId == request.auth.uid &&
        request.resource.data.status == 'pending';
      allow read: if isAuthenticated();
      allow update: if isSuperAdmin() || isStudioOwnerOrHeadTrainer(resource.data.targetStudioId);
      allow delete: if isSuperAdmin();
    }

    // Webhook idempotency log (server-only writes; admins can read)
    // Path: mindbodyEventLog/{messageId}
    match /mindbodyEventLog/{messageId} {
      allow read: if isSuperAdmin();
      allow write: if false;
    }

    // Dead letter queue (server writes; admins read and resolve)
    // Path: mindbodyDLQ/{messageId}
    match /mindbodyDLQ/{messageId} {
      allow read: if isSuperAdmin();
      allow update: if isSuperAdmin();
      allow create, delete: if false;
    }

    // Global integration health (server writes; all authenticated users read for UI)
    // Path: system/health
    match /system/health {
      allow read: if isAuthenticated();
      allow write: if false;
    }

  }
}
